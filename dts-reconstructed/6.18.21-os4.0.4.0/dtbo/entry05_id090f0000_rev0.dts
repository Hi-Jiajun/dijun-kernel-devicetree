					cirrus,init-delay-ms = <0x1e>;
					cirrus,micd-dbtime = <0x01>;
					cirrus,micd-timeout-ms = <0x3e8>;
					cirrus,micd-force-micbias;
					cirrus,hpdet-short-circuit-imp = <0x02>;
					cirrus,micd-ranges = <0x46 0xe2 0x12c 0x101 0x320 0x102>;
