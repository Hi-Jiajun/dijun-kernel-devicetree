						dsi-panel-on-command-state = "dsi_hs_mode";
						dsi-panel-off-command = [39 00 00 40 00 00 02 65 00 39 00 00 40 00 00 02 38 00 39 00 00 00 32 00 02 2c 00 05 00 00 00 00 00 01 28 05 00 00 00 78 00 01 10];
						dsi-panel-off-command-state = "dsi_hs_mode";
