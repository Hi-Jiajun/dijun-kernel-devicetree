					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			spi6_cs_sleep {
				phandle = <0x17>;

				mux {
					pins = "PAD_GPIO_123";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_123";
					drive-strength = <0x02>;
					bias-disable;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-high;
				};
			};

			spi6_cs_init {
				phandle = <0x0f>;

				mux {
					pins = "PAD_GPIO_123";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_123";
					drive-strength = <0x02>;
					bias-disable;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-high;
				};
			};

			spi6_cs_default {
				phandle = <0x13>;

				mux {
					pins = "PAD_GPIO_123";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_123";
					drive-strength = <0x02>;
					bias-disable;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-low;
				};
			};
		};
	};

