	fragment@60 {
		target = <&dw_i2c10>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0xf4240>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			pinctrl-names = "init", "default", "sleep";
			pinctrl-0 = <&{/fragment@59/__overlay__/i2c10_scl_init}>, <&{/fragment@59/__overlay__/i2c10_sda_init}>;
			pinctrl-1 = <&{/fragment@59/__overlay__/i2c10_scl_default}>, <&{/fragment@59/__overlay__/i2c10_sda_default}>;
			pinctrl-2 = <&{/fragment@59/__overlay__/i2c10_scl_sleep}>, <&{/fragment@59/__overlay__/i2c10_sda_sleep}>;

			nq@28 {
				compatible = "nxp,sn-nci";
				reg = <0x28>;
				nxp,sn-irq = <&dw_gpio2>, <0x0b 0x00>;
				nxp,sn-ven-rstn = <&dw_gpio3>, <0x04 0x00>;
				interrupt-parent = <&dw_gpio2>;
				pinctrl-names = "nfc_active", "nfc_suspend";
				pinctrl-0 = <&{/fragment@59/__overlay__/nfc_int_active}>, <&{/fragment@59/__overlay__/nfc_enable_active}>;
				pinctrl-1 = <&{/fragment@59/__overlay__/nfc_int_suspend}>, <&{/fragment@59/__overlay__/nfc_enable_suspend}>;
				clocks = <&xr_clk>, <0x1e3>;
				clock-names = "clk_38m4_o4";
			};
		};
	};

	fragment@61 {
		target-path = "/";

		__overlay__ {

			media1_vdec_smmu_test {
				compatible = "xring,smmu_test";
				status = "okay";
				smmu_test = "media1_vdec";
				iommus = <&media1_smmu>, <0x20 0x20>;

				iova-info {
					iova-reserve = <0x00 0x00 0x00 0x40000000>;
				};
			};

			media2_venc_smmu_test {
				compatible = "xring,smmu_test";
				status = "okay";
				smmu_test = "media2_venc";
				iommus = <&media2_smmu>, <0x21 0x21>;

				iova-info {
					iova-reserve = <0x00 0x00 0x00 0x40000000>;
				};
			};

			pcie_smmu_test {
				compatible = "xring,smmu_test";
				status = "disabled";
				smmu_test = "hss2_pcie";
				iommus = <&pcie_smmu>, <0x22 0x22>;

				iova-info {
					iova-reserve = <0x00 0x00 0x00 0x40000000>;
				};
			};
		};
	};

