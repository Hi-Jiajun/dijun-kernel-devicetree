	fragment@52 {
		target-path = "/";

		__overlay__ {

			pwrctl {
				compatible = "mediatek,wwan_pwrctl";
				pmic-en = <&dw_gpio7>, <0x06 0x00>;
				pmic-rst = <&dw_gpio6>, <0x1c 0x00>;
				reset-eint = <&dw_gpio2>, <0x10 0x00>;
				md-dump = <&dw_gpio5>, <0x0a 0x00>;
				pmic-faultb = <&dw_gpio1>, <0x1b 0x00>;
				pcie-wake = <&dw_gpio1>, <0x1a 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&{/fragment@53/__overlay__/gpio_221_default}>, <&{/fragment@53/__overlay__/gpio_211_default}>, <&{/fragment@53/__overlay__/gpio_080_default}>, <&{/fragment@53/__overlay__/gpio_155_default}>, <&{/fragment@53/__overlay__/gpio_058_default}>, <&{/fragment@53/__overlay__/gpio_059_default}>;
			};

			gpio-sap-ctrl {
				compatible = "mediatek,gpio_sap_ctrl";
				pinctrl-names = "sap_off", "sap_download_pd", "sap_download_pu", "sap_working_pd", "sap_working_pu", "sap_working_nopull";
				pinctrl-0 = <&{/fragment@53/__overlay__/uart2_4_txd_init}>, <&{/fragment@53/__overlay__/uart2_4_rxd_init}>, <&{/fragment@53/__overlay__/uart0_4_txd_init}>, <&{/fragment@53/__overlay__/uart0_4_rxd_init}>;
				pinctrl-1 = <&{/fragment@53/__overlay__/uart2_4_txd_init}>, <&{/fragment@53/__overlay__/uart2_4_rxd_init}>, <&{/fragment@53/__overlay__/uart0_4_txd_init}>, <&{/fragment@53/__overlay__/uart0_4_rxd_init}>;
				pinctrl-2;
				pinctrl-3;
				pinctrl-4 = <&{/fragment@53/__overlay__/uart2_4_rxd_default}>, <&{/fragment@53/__overlay__/uart0_4_rxd_default}>;
				pinctrl-5 = <&{/fragment@53/__overlay__/uart2_4_txd_default}>, <&{/fragment@53/__overlay__/uart0_4_txd_default}>;
			};

			md2ap-timetick-sync {
				compatible = "mediatek,timesync";
				mdm-gnss-sync = <&dw_gpio1>, <0x17 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&{/fragment@53/__overlay__/gpio_055_default}>;
			};
		};
	};

	fragment@53 {
		target = <&pinctrl_configs>;

		__overlay__ {

			pdm0_clk_init {
				phandle = <0x65>;

				mux {
					pins = "PAD_GPIO_001";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_001";
					bias-pull-down;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			pdm0_clk_default {
				phandle = <0x67>;

