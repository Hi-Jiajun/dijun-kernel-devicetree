					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			spi1_cs_default {
				phandle = <0x1a0>;

				mux {
					pins = "PAD_GPIO_166";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_166";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-low;
				};
			};

			gpio_se_07 {
				phandle = <0x1bd>;

				mux {
					pins = "PAD_GPIO_076";
					function = "LPIS_GPIO_SE_07";
				};

				pinconf {
					pins = "PAD_GPIO_076";
					bias-pull-up;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};
		};
	};

	fragment@54 {
		target = <&wifi>;

		__overlay__ {
			status = "okay";
			compatible = "xring,f1-wifi";
			wf-rst-gpio = <&dw_gpio4>, <0x00 0x00>;
			wf-wk-gpio = <&dw_gpio0>, <0x0c 0x00>;
			pinctrl-names = "wf_rst_off", "wf_rst_on", "wf_rst_sleep", "wf_wk_host_on", "wf_wk_host_off", "wf_wk_host_sleep";
			pinctrl-0 = <&{/fragment@53/__overlay__/gpio_113_init}>;
			pinctrl-1 = <&{/fragment@53/__overlay__/gpio_113_default}>;
			pinctrl-2 = <&{/fragment@53/__overlay__/gpio_113_sleep}>;
			pinctrl-3 = <&{/fragment@53/__overlay__/gpio_012_default}>;
			pinctrl-4 = <&{/fragment@53/__overlay__/gpio_012_init}>;
			pinctrl-5 = <&{/fragment@53/__overlay__/gpio_012_sleep}>;
			memory-region = <&wifi_mem>;
		};
	};

	fragment@55 {
		target = <&wifi_page_pool>;

		__overlay__ {
			status = "okay";
			compatible = "mediatek,wifi_page_pool";
			emi-size = <0x5400000>;
			dynamic-alloc = <0x01>;
			memory-region = <&wifi_page_pool_mem>;
		};
	};

	fragment@56 {
		target = <&connfem>;

		__overlay__ {
			status = "okay";
			compatible = "mediatek,mt6985-connfem";

			epa_elna {
				parts = <&{/fragment@56/__overlay__/qm42195}>, <&{/fragment@56/__overlay__/qm45197}>;

				common {

					flags-0 {
						rx-mode = [00];
						fe-ant-cnt = [81];
						fe-main-bt-share-lp2g = [80];
						fe-conn-spdt = [80];
						fe-reserved = [80];
					};
				};

				wifi {

					flags-0 {
						epa-option = [aa];
					};
				};

				bt {

					flags-0 {
						epa_elna;
					};
				};
			};

			qm42639 {
				vid = <0x03>;
				pid = <0x03>;
			};

			qm45639 {
				vid = <0x03>;
				pid = <0x04>;
			};

			qm42195 {
				vid = <0x03>;
				pid = <0x01>;
				phandle = <0x113>;
			};

			qm45197 {
				vid = <0x03>;
				pid = <0x02>;
				phandle = <0x114>;
			};

			qm42639_qm45639 {
				mapping = <0x00 0x03 0x00 0x01 0x02 0x00 0x02 0x04 0x00 0x03 0x0e 0x00 0x04 0x83 0x00 0x05 0x82 0x00 0x06 0x84 0x00 0x07 0x8e 0x00 0x12 0x4a 0x00 0x0c 0x4b 0x00 0x14 0x4c 0x00 0x0d 0x41 0x00 0x0e 0xca 0x00 0x0f 0xcb 0x00 0x10 0xcc 0x00 0x11 0xc1 0x00 0x08 0x05 0x00 0x09 0x46 0x01 0x16 0x27 0x00 0x17 0x29 0x01>;
			};

			qm42195_qm45197 {
				mapping = <0x00 0x03 0x00 0x01 0x02 0x00 0x02 0x04 0x00 0x04 0x83 0x00 0x05 0x82 0x00 0x06 0x84 0x00 0x12 0x4a 0x00 0x0c 0x4b 0x00 0x14 0x4c 0x00 0x0e 0xca 0x00 0x0f 0xcb 0x00 0x10 0xcc 0x00>;
			};
		};
	};

	fragment@57 {
		target = <&connv3>;

		__overlay__ {
			status = "okay";
			compatible = "xring,f1-connv3";
			pinctrl-0 = <&{/fragment@53/__overlay__/gpio_115_init}>;
			pinctrl-1 = <&{/fragment@53/__overlay__/gpio_115_default}>;
			pinctrl-2 = <&{/fragment@53/__overlay__/gpio_115_init}>;
			pinctrl-3 = <&{/fragment@53/__overlay__/gpio_003_init}>;
			pinctrl-4 = <&{/fragment@53/__overlay__/gpio_003_default}>;
			pinctrl-5 = <&{/fragment@53/__overlay__/gpio_115_sleep}>;
			pinctrl-6 = <&{/fragment@53/__overlay__/gpio_003_sleep}>;
			pinctrl-7 = <&{/fragment@53/__overlay__/uart1_4_txd_init}>;
			pinctrl-8 = <&{/fragment@53/__overlay__/uart1_4_txd_default}>;
			pinctrl-9 = <&{/fragment@53/__overlay__/uart1_4_txd_sleep}>;
			pinctrl-10 = <&{/fragment@53/__overlay__/uart1_4_rxd_init}>;
			pinctrl-11 = <&{/fragment@53/__overlay__/uart1_4_rxd_default}>;
			pinctrl-12 = <&{/fragment@53/__overlay__/uart1_4_rxd_sleep}>;
			pinctrl-13 = <&{/fragment@53/__overlay__/uart1_4_txd_pre}>;
			pinctrl-14 = <&{/fragment@53/__overlay__/uart1_4_rxd_pre}>;
			pinctrl-15 = <&{/fragment@77/__overlay__/gpio_084_default}>;
			pinctrl-16 = <&{/fragment@77/__overlay__/gpio_084_init}>;
			#interrupt-parent = <&dw_gpio0>;
			pmic-gpio = <&dw_gpio0>, <0x03 0x00>, <&dw_gpio4>, <0x02 0x00>;
			#interrupts = <0x01 0x02>;
			clocks = <&xr_clk>, <0x1df>;
			clock-names = "clk_32k_o2";
		};
	};

	fragment@58 {
		target = <&xiaomi_wifi_gpio>;

		__overlay__ {
			status = "okay";
			compatible = "wlan,xiaomi_wifi_gpio";
			status-gpio = <&dw_gpio1>, <0x07 0x00>;
			debounce-time = <0x1e>;
			pinctrl-names = "default";
			pinctrl-0 = <&{/fragment@53/__overlay__/gpio_039_default}>;
		};
	};

	fragment@59 {
		target = <&pinctrl_configs>;

		__overlay__ {

			nfc_int_active {
				phandle = <0x12c>;

				mux {
					pins = "PAD_GPIO_075";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_075";
					drive-strength = <0x01>;
					bias-disable;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			nfc_int_suspend {
				phandle = <0x12e>;

				mux {
					pins = "PAD_GPIO_075";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_075";
					drive-strength = <0x01>;
					bias-disable;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			nfc_enable_active {
				phandle = <0x12d>;

				mux {
					pins = "PAD_GPIO_085";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_085";
					drive-strength = <0x01>;
					bias-disable;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-high;
				};
			};

			nfc_enable_suspend {
				phandle = <0x12f>;

				mux {
					pins = "PAD_GPIO_085";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_085";
					drive-strength = <0x01>;
					bias-disable;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-high;
				};
			};

			i2c10_scl_init {
				phandle = <0x126>;

				mux {
					pins = "PAD_GPIO_136";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_136";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			i2c10_scl_default {
				phandle = <0x128>;

				mux {
					pins = "PAD_GPIO_136";
					function = "I2C10";
				};

				pinconf {
					pins = "PAD_GPIO_136";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
				};
			};

			i2c10_scl_sleep {
				phandle = <0x12a>;

				mux {
					pins = "PAD_GPIO_136";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_136";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			i2c10_sda_init {
				phandle = <0x127>;

				mux {
					pins = "PAD_GPIO_137";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_137";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			i2c10_sda_default {
				phandle = <0x129>;

				mux {
					pins = "PAD_GPIO_137";
					function = "I2C10";
				};

				pinconf {
					pins = "PAD_GPIO_137";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
				};
			};

			i2c10_sda_sleep {
				phandle = <0x12b>;

				mux {
					pins = "PAD_GPIO_137";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_137";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			spi0_clk_init {
				phandle = <0x1a1>;

				mux {
					pins = "PAD_GPIO_159";
					function = "SPI0";
				};

				pinconf {
					pins = "PAD_GPIO_159";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			spi0_clk_default {
				phandle = <0x1a5>;

				mux {
					pins = "PAD_GPIO_159";
					function = "SPI0";
				};

				pinconf {
					pins = "PAD_GPIO_159";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-low;
				};
			};

			spi0_clk_sleep {
				phandle = <0x1a9>;

				mux {
					pins = "PAD_GPIO_159";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_159";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			spi0_mosi_init {
				phandle = <0x1a2>;

				mux {
					pins = "PAD_GPIO_160";
					function = "SPI0";
				};

				pinconf {
					pins = "PAD_GPIO_160";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			spi0_mosi_default {
				phandle = <0x1a6>;

				mux {
					pins = "PAD_GPIO_160";
					function = "SPI0";
				};

				pinconf {
					pins = "PAD_GPIO_160";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-low;
				};
			};

			spi0_mosi_sleep {
				phandle = <0x1aa>;

				mux {
					pins = "PAD_GPIO_160";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_160";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			spi0_miso_init {
				phandle = <0x1a3>;

				mux {
					pins = "PAD_GPIO_161";
					function = "SPI0";
				};

				pinconf {
					pins = "PAD_GPIO_161";
					bias-disable;
					drive-strength = <0x01>;
					input-schmitt-disable;
					slew-rate = <0x00>;
					input-enable;
				};
			};

			spi0_miso_default {
				phandle = <0x1a7>;

				mux {
					pins = "PAD_GPIO_161";
					function = "SPI0";
				};

				pinconf {
					pins = "PAD_GPIO_161";
					bias-disable;
					drive-strength = <0x01>;
					input-schmitt-disable;
					slew-rate = <0x00>;
					input-enable;
				};
			};

			spi0_miso_sleep {
				phandle = <0x1ab>;

				mux {
					pins = "PAD_GPIO_161";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_161";
					bias-pull-down;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			spi0_cs_init {
				phandle = <0x1a4>;

				mux {
					pins = "PAD_GPIO_170";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_170";
					drive-strength = <0x01>;
					bias-disable;
					input-schmitt-disable;
					slew-rate = <0x00>;
					output-high;
				};
			};

			spi0_cs_default {
				phandle = <0x1a8>;

				mux {
					pins = "PAD_GPIO_170";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_170";
					drive-strength = <0x01>;
					bias-disable;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-high;
				};
			};

			spi0_cs_sleep {
				phandle = <0x1ac>;

				mux {
					pins = "PAD_GPIO_170";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_170";
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					bias-disable;
					output-high;
