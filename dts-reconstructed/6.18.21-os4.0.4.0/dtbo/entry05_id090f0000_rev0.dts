/dts-v1/;
/plugin/;

/ {
	board_id = <0x90f0000>;
	board_rev = <0x00>;

	fragment@0 {
		target-path = "/";

		__overlay__ {
			model = "XiaoMi Xring_o1 O2S PHONE";
			compatible = "XiaoMi,Xring_o1-o2s-phone";
			#size-cells = <0x02>;
			#address-cells = <0x02>;

			freq-level {
				status = <0x02>;
			};

			mtdoops_pmsg@a0000000 {
				compatible = "xiaomi,mtdoops_pmsg";
				reg = <0x00 0xa0000000 0x00 0x100000>;
				record-size = <0x80000>;
				console-size = <0x40000>;
				pmsg-size = <0x40000>;
			};

			wp_panel {
				compatible = "wp,wp_panel";
				status = "okay";
			};
		};
	};

	fragment@1 {
		target = <&usb>;

		__overlay__ {
			u3-eye-param-host = <0x9600 0xc0007e00 0x8004a602 0x2000007f>;
			u3-eye-param-device = <0x9600 0xc0007e00 0x8004a602 0x2000007f>;
		};
	};

	fragment@2 {
		target = <&cpnv>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@3 {
		target = <&dwc3>;

		__overlay__ {
			snps,usb3_lpm_capable;
			snps,dis_enblslpm_quirk;
			snps,usb2-gadget-lpm-disable;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			maximum-speed = "super-speed-plus";
		};
	};

	fragment@4 {
		target-path = "/";

		__overlay__ {
			#size-cells = <0x02>;
			#address-cells = <0x02>;

			memory_dump@0 {
				compatible = "xring,memory_dump";
				memory-region = <&memdump_reserve>;
				status = "okay";
			};

			osc-384k {
				compatible = "fixed-clock";
				#clock-cells = <0x00>;
				clock-frequency = <0x249f000>;
				clock-output-names = "osc384k";
			};

			mdr {
				fpga_flag = <0x00>;
			};

			uart_switch {
				status = "disabled";
				reg = <0x00 0xe0009700 0x00 0x04 0x00 0xec130000 0x00 0x1000 0x00 0xe1506000 0x00 0x1000>;
				switch_mode = <0x01>;
				uart_chan_num = <0x04>;
				is_secure_reg = <0x01 0x00 0x01 0x00>;
				uart_chan_options = "lpcore", "jtag", "ap", "xctrl_cpu", "xctrl_ddr", "sensorhub", "xrse", "gpio", "ap", "ddr_mcu1", "ddr_mcu2", "ddr_mcu3", "ddr_mcu4", "gpio", "xrse", "spi2", "xctrl_ddr", "npu", "gpio", "i2c15", "xctrl_cpu", "npu", "sensorhub", "adsp", "isp";
				uart_chans = <0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x02 0x02 0x02 0x02 0x02 0x02 0x03 0x03 0x03 0x03 0x03 0x04 0x04 0x04 0x04 0x04 0x04 0x04>;
				sctrl_val = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x1000 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				sctrl_mask = <0x10000 0x00 0x20000 0x40000 0x80000 0x400000 0x200000 0x00 0x20000 0x2000000 0x2000000 0x2000000 0x2000000 0x00 0x200000 0x00 0x10080000 0x10080000 0x00 0x00 0x40000 0x100000 0x400000 0x800000 0x1000000>;
				config_val = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x00 0x01 0x02 0x03 0x04 0x05 0x00 0x01 0x02 0x03 0x03 0x00 0x01 0x02 0x03 0x04 0x05 0x06>;
			};
		};
	};

	fragment@5 {
		target = <&pinctrl>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@6 {
		target = <&serial0>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@7 {
		target = <&perf_mon>;

		__overlay__ {
			status = "okay";
			memory-region = <&perf>;
			time-shift = <0xf4240>;
		};
	};

	fragment@8 {
		target = <&xring_ipc>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@9 {
		target = <&sensorhub>;

		__overlay__ {
			status = "okay";

			i3c {
				status = "okay";

				i3c3 {
					status = "okay";
				};
			};

			uart {
				status = "okay";

				uart1 {
					status = "okay";
				};

				uart11 {
					status = "okay";
				};
			};

			sensor_power {
				status = "okay";
				power-supply = <&lldo3>, <&mldo4>, <&hldo6>;
				power-id-volt = <0x12 0x124f80 0x18 0x1b7740 0x22 0x325aa0>;
			};
		};
	};

	fragment@10 {
		target = <&xring_firq>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@11 {
		target = <&intr_sensorhub_to_acpu>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@12 {
		target = <&pstore>;

		__overlay__ {
			compatible = "ramoops";
			record-size = <0x40000>;
			console-size = <0x80000>;
			pmsg-size = <0x40000>;
		};
	};

	fragment@13 {
		target = <&xr_kdump>;

		__overlay__ {
			status = "okay";
			memory-region = <&memdump_reserve>;
		};
	};

	fragment@14 {
		target = <&pmic>;

		__overlay__ {

			uefi_mbuck1 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck1";
				regulator-id = <0x00>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
			};

			uefi_mbuck2 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck2";
				regulator-id = <0x01>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
			};

			uefi_mbuck3 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck3";
				regulator-id = <0x02>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
			};

			uefi_mbuck4 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck4";
				regulator-id = <0x03>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
			};

			uefi_mbuck5 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck5";
				regulator-id = <0x04>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
			};

			uefi_mbuck6 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck6";
				regulator-id = <0x05>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
			};

			uefi_mbuck8 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck8";
				regulator-id = <0x07>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
			};

			uefi_mbuck9 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck9";
				regulator-id = <0x08>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x15aae0>;
				step-uV = <0x1388>;
			};

			uefi_ulldo3 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "ulldo3";
				regulator-id = <0x0c>;
				regulator-min-microvolt = <0x83d60>;
				regulator-max-microvolt = <0x142440>;
				step-uV = <0x2710>;
			};

			uefi_ulldo4 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "ulldo4";
				regulator-id = <0x0d>;
				regulator-min-microvolt = <0x83d60>;
				regulator-max-microvolt = <0x142440>;
				step-uV = <0x2710>;
			};

			uefi_ulldo6 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "ulldo6";
				regulator-id = <0x0f>;
				regulator-min-microvolt = <0x83d60>;
				regulator-max-microvolt = <0x142440>;
				step-uV = <0x2710>;
			};

			uefi_lldo1 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "lldo1";
				regulator-id = <0x10>;
				regulator-min-microvolt = <0x83d60>;
				regulator-max-microvolt = <0x142440>;
				step-uV = <0x2710>;
			};

			uefi_lldo2 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "lldo2";
				regulator-id = <0x11>;
				regulator-min-microvolt = <0x83d60>;
				regulator-max-microvolt = <0x142440>;
				step-uV = <0x2710>;
			};

			uefi_mldo3 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mldo3";
				regulator-id = <0x17>;
				regulator-min-microvolt = <0x192d50>;
				regulator-max-microvolt = <0x1de840>;
				step-uV = <0x2710>;
			};

			vdd_media {
				compatible = "xring,regulator_lpcore";
				regulator-name = "vdd_media";
				regulator-id = <0x07>;
				vote-mngs = <&m1_arbiter_lpctrl>, <0x02>;
				vote-mng-names = "m1_mng_vdd_media";
				regulator-min-microvolt = <0x493e0>;
				regulator-max-microvolt = <0x13d620>;
				status = "disabled";
			};
		};
	};

	fragment@15 {
		target = <&usb_adsp>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@16 {
		target-path = "/";

		__overlay__ {

			fake_dsi_panel {
				status = "okay";
				dsi-panel-name = "fake_dsi_panel";
				dsi-panel-id = <0x00>;
				dsi-panel-type = "dsi_video_mode";
				dsi-burst-mode = "non_burst_sync_pulses";
				dsi-panel-width = <0x5a0>;
				dsi-panel-height = <0xc80>;
				dsi-panel-backlight-setting-type = "cmd";
				dsi-panel-brightness-max-level = <0x7ff>;
				dsi-panel-brightness-min-level = <0x14>;
				dsi-panel-brightness-init-level = <0x7ff>;
				dsi-panel-phy-type = "dphy";
				dsi-panel-clk-type = "non_continuous";
				dsi-panel-lane-number = <0x04>;
				dsi-panel-lane-rate = <0x26be414e>;
				dsi-panel-pixel-clock = <0xcea270>;
				dsi-panel-bpp = <0x18>;
				dsi-panel-virtual-channel = <0x00>;
				dsi-fake-panel-enable;
				dsi-panel-hdr-enabled;
				dsi-panel-peak-brightness = <0x401640>;
				dsi-panel-blackness-level = <0xc9e>;
				dsi-panel-physical-width-dimension = <0x2bd>;
				dsi-panel-physical-height-dimension = <0x616>;
				dsi-panel-physical-type = "ltpo";
				dsi-panel-te-sel = [00];
				dsi-panel-port-mask = [01];
				dsi-panel-boot-up-profile = <0x01>;
				dsi-panel-lowpower-ctrl = <0x00>;
				dsi-panel-frame-power-mask = <0x00>;
				dsi-panel-frame-power-max-refresh-rate = <0x00>;
				dsi-panel-idle-policy = <0x00>;
				dsi-panel-dsc-compression-mode = "dsc";
				dsi-panel-dsc-version = <0x12>;
				dsi-panel-dsc-scr-version = <0x00>;
				dsi-panel-dsc-pic-height = <0xc80>;
				dsi-panel-dsc-pic-width = <0x5a0>;
				dsi-panel-dsc-slice-height = <0x14>;
				dsi-panel-dsc-slice-width = <0x2d0>;
				dsi-panel-dsc-bpc = [0a];
				dsi-panel-dsc-bpp = [08];
				phandle = <0x0b>;

				dsi-display-timings {

					default_index_00 {
						dsi-panel-frame-rate = <0x3c>;
						dsi-panel-vrr-type = <0x00>;
						dsi-panel-width = <0x5a0>;
						dsi-panel-height = <0xc80>;
						dsi-panel-h-front-porch = <0x10>;
						dsi-panel-h-back-porch = <0x10>;
						dsi-panel-h-pulse-width = <0x10>;
						dsi-panel-h-sync-skew = <0x00>;
						dsi-panel-v-back-porch = <0x18>;
						dsi-panel-v-front-porch = <0x40>;
						dsi-panel-v-pulse-width = <0x04>;
						dsi-panel-timing-switch-command = <0x39000040 0x226 0x3390000 0x40000002 0x2f003900 0x400000 0x22f3039 0x4000 0x6f055 0xaa520800 0x39000040 0x26f 0x1c390000 0x4000000a 0xba910101 0x10101 0x3900 0x400000 0x2bc2039 0x00 0x22c00>;
						dsi-panel-timing-switch-command-update = <0x26 0x00 0x01>;
						dsi-panel-timing-switch-command-state = "dsi_hs_mode";
						dsi-panel-on-command = <0x39000040 0x6f0 0x55aa5208 0x390000 0x40000002 0x6f033900 0x400000 0x3c02445 0x39000040 0x6f0 0x55aa5208 0x1390000 0x40000002 0x6f053900 0x400000 0x3c72708 0x39000040 0x26f 0x8390000 0x40000003 0xc7000039 0x4000 0x6f055 0xaa520805 0x39000040 0x8cb 0x11111111 0x11111139 0x4000 0x6f055 0xaa520807 0x39000040 0x16d5 0x21003d09 0x3d090000 0x3fc46536 0x3fc46536 0xe8d4a 0x51150000 0x40000002 0x6f153900 0x400000 0x11d52422 0x52cf9932 0xaf33f083 0x833d0900 0x1500 0x400000 0x26f2539 0x4000 0x8d500 0x00 0x3900 0x400000 0x16d62700 0x3d093d09 0x00 0x3fc4 0x65360000 0x15 0x4000 0x26f15 0x39000040 0x11d6 0x2423d04d 0x9932af33 0x307d8300 0x00 0x15000040 0x26f 0x25390000 0x40000008 0xd6000000 0x00 0x39000040 0x16d7 0x2b003d09 0x3d090000 0x00 0x00 0x7ff172b5 0xaf150000 0x40000002 0x6f153900 0x400000 0x11d75823 0xd04d9ab0 0x2d330f7d 0x7dc2f700 0x1500 0x400000 0x26f2539 0x4000 0x8d700 0x00 0x3900 0x400000 0x16d82d00 0x3d093d09 0x3fc4 0x65360000 0x00 0x15 0x4000 0x26f15 0x39000040 0x11d8 0x582252cf 0x9ab02d33 0xc0837d00 0x00 0x15000040 0x26f 0x25390000 0x40000008 0xd8000000 0x00 0x39000040 0x6f0 0x55aa5208 0x390000 0x40000002 0x6f1b3900 0x400000 0x9df0252 0x932034d 0xa2d3900 0x400000 0x6f055aa 0x52080039 0x4000 0x2de03 0x39000040 0x6f0 0x55aa5208 0x390000 0x40000005 0xbe474f4c 0x4b390000 0x40000002 0x6f093900 0x400000 0x2be2d39 0x4000 0x6f055 0xaa520805 0x39000040 0x26f 0x2390000 0x40000002 0xb00f3900 0x400000 0xac38600 0x81000000 0x80000a39 0x4000 0x6f055 0xaa520808 0x39000040 0x6c2 0x22803b01 0x81390000 0x40000002 0xc7113900 0x400000 0xfcb0000 0x00 0x00 0x00 0x39000040 0xfcc 0x00 0x00 0x00 0x3900 0x400000 0xfce0000 0x00 0x00 0x00 0x39000040 0x3d3 0x80013900 0x400000 0x26f0239 0x4000 0x6d310 0xb40090 0x39000040 0x26f 0x7390000 0x40000005 0xd3000000 0x390000 0x40000006 0xf055aa52 0x8013900 0x400000 0x26f0139 0x4000 0x2d200 0x39000040 0x6f0 0x55aa5208 0x1390000 0x40000002 0x6f053900 0x400000 0x2e30039 0x4000 0x26f0a 0x39000040 0x3e3 0x3900 0x400000 0x6f055a