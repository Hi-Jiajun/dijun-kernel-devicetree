					vset_valid_addr = <0x7f>;
					rampup_valid_addr = <0x07>;
					rampdn_valid_addr = <0x70>;
					status = "disabled";
				};

				aoc_wldo {
					wldo_name = "wl28661d";
					i2c_mst_name = "i2c5";
					i2c_mst_port = <0x05>;
					type = <0x01>;
					wldo_chipid = <0x33>;
					wldo_chipid_addr = <0x00>;
					wldo_en_addr = <0x0e>;
					wldo_slave_addr = <0x28>;
					wldo_i2c_freq = <0x61a80>;
					subldo-names = "WL2_LDO3", "WL2_LDO1";

					WL2_LDO3 {
						sub_ldo_name = "WL2_LDO3";
						ldo_regaddr = <0x05>;
						ldo_num = <0x03>;
						ldo_volt_mv = <0x2ab980>;
					};

					WL2_LDO1 {
						sub_ldo_name = "WL2_LDO1";
						ldo_regaddr = <0x03>;
						ldo_num = <0x01>;
						ldo_volt_mv = <0x124f80>;
					};
				};

				csi_clk {
					clk_name = "csi_clk";
					csi_clk_normal = <0x23c34600>;
					csi_clk_low = <0xc35000>;
					csi_clk_id = <0x62>;
				};

				aoc_mclk {
					mclk_name = "gpio_mclk";
					mclk_id = <0x5b>;
					mclk_io_num = <0xe0>;
					mclk_rate = <0x124f800>;
					is_osc_clk = <0x00>;
				};

				aoc_gpio {
					gpio-names = "gpio_ls_en", "gpio_rst", "gpio_vio";
					gpio-nums = <0x57 0xea 0xa9>;
					gpio-mode = <0x00 0x00 0x00>;
					gpio-def-val = <0x00 0x00 0x00>;
				};

				aoc_pu_seq {
					seq-names = "sensor_bob1", "sensor_mclk", "sensor_camio", "sensor_avdd", "sensor_dvdd", "sensor_reset";
					seq-table = <0x02 0x09 0x05 0x01 0x00 0x08>;
					seq-delay = <0x06 0x06 0x02 0x02 0x02 0x09>;
					seq-val = <0x00 0x00 0x00 0x00 0x00 0x00>;
