				pinconf {
					pins = "PAD_GPIO_084";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-low;
				};
			};

			gpio_084_default {
				phandle = <0x10b>;

				mux {
					pins = "PAD_GPIO_084";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_084";
					bias-disable;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-high;
				};
			};
		};
	};

