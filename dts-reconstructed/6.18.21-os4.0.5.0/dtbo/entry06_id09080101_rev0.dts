	fragment@72 {
		target = <&thermal_zones>;

		__overlay__ {

			quiet_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x00>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			cpu_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x01>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			charger_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x02>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			wifi_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x03>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			flash_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x04>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			wireless_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x07>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			conn_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x08>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			cpub-pause {

				cooling-maps {

					cpu8_pause_cdev {
						trip = <&cpubpause_trip2>;
						cooling-device = <&cpu8_pause>, <0x01 0x01>;
					};

					cpu9_pause_cdev {
						trip = <&cpubpause_trip2>;
						cooling-device = <&cpu9_pause>, <0x01 0x01>;
					};
				};
			};

			npu-ss-max {

				cooling-maps {

					npufreq_cdev {
						trip = <&npu_trip1>;
						cooling-device = <&npufreq>, <0xffffffff 0xffffffff>;
					};
				};
			};

			gpu-ss-max {

				cooling-maps {

					gpufreq_cdev {
						trip = <&gpu_trip1>;
						cooling-device = <&gpufreq>, <0xffffffff 0xffffffff>;
					};
				};
			};

			shell-thermal {

				cooling-maps {

					map1 {
						trip = <&shell_target>;
						cooling-device = <&CPU0>, <0xffffffff 0x04>, <&CPU2>, <0xffffffff 0x05>, <&CPU4>, <0xffffffff 0x0d>;
						contribution = <0x800>;
					};

					map2 {
						trip = <&shell_target>;
						cooling-device = <&CPU8>, <0xffffffff 0xffffffff>;
						contribution = <0x400>;
					};
				};
			};

			soc-hp {

				cooling-maps {

					cpu8_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&cpu8_hotplug>, <0x01 0x01>;
					};

					cpu9_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&cpu9_hotplug>, <0x01 0x01>;
					};

					gpu_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&gpu_hotplug>, <0xffffffff 0xffffffff>;
					};
				};
			};
		};
	};

