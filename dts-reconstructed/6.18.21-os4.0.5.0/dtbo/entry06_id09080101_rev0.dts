				aoc_pd_seq {
					seq-names = "sensor_reset", "sensor_dvdd", "sensor_avdd", "sensor_camio", "sensor_bob1", "sensor_mclk";
					seq-table = <0x08 0x00 0x01 0x05 0x02 0x09>;
					seq-delay = <0x01 0x00 0x00 0x00 0x00 0x00>;
					seq-val = <0x00 0x00 0x00 0x00 0x00 0x00>;
				};
			};
		};
	};

