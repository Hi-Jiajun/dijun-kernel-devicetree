	fragment@59 {
		target = <&wifi>;

		__overlay__ {
			status = "okay";
			compatible = "xring,f1-wifi";
			wf-rst-gpio = <&dw_gpio4>, <0x00 0x00>;
			wf-wk-gpio = <&dw_gpio0>, <0x0c 0x00>;
			pinctrl-names = "wf_rst_off", "wf_rst_on", "wf_rst_sleep", "wf_wk_host_on", "wf_wk_host_off", "wf_wk_host_sleep";
			pinctrl-0 = <&{/fragment@58/__overlay__/gpio_113_init}>;
			pinctrl-1 = <&{/fragment@58/__overlay__/gpio_113_default}>;
			pinctrl-2 = <&{/fragment@58/__overlay__/gpio_113_sleep}>;
			pinctrl-3 = <&{/fragment@58/__overlay__/gpio_012_default}>;
			pinctrl-4 = <&{/fragment@58/__overlay__/gpio_012_init}>;
			pinctrl-5 = <&{/fragment@58/__overlay__/gpio_012_sleep}>;
			memory-region = <&wifi_mem>;
		};
	};

	fragment@60 {
		target = <&wifi_page_pool>;

		__overlay__ {
			status = "okay";
			compatible = "mediatek,wifi_page_pool";
			emi-size = <0x5400000>;
			dynamic-alloc = <0x01>;
			memory-region = <&wifi_page_pool_mem>;
		};
	};

	fragment@61 {
		target = <&connfem>;

		__overlay__ {
			status = "okay";
			compatible = "mediatek,mt6985-connfem";

			epa_elna {
				parts = <&{/fragment@61/__overlay__/qm42195}>, <&{/fragment@61/__overlay__/qm45197}>;

				common {

					flags-0 {
						rx-mode = [00];
						fe-ant-cnt = [81];
						fe-main-bt-share-lp2g = [80];
						fe-conn-spdt = [80];
						fe-reserved = [80];
					};
				};

				wifi {

					flags-0 {
						epa-option = [aa];
					};
				};

				bt {

					flags-0 {
						epa_elna;
					};
				};
			};

			qm42639 {
				vid = <0x03>;
				pid = <0x03>;
			};

			qm45639 {
				vid = <0x03>;
				pid = <0x04>;
			};

			qm42195 {
				vid = <0x03>;
				pid = <0x01>;
				phandle = <0xde>;
			};

			qm45197 {
				vid = <0x03>;
				pid = <0x02>;
				phandle = <0xdf>;
			};

			qm42639_qm45639 {
				mapping = <0x00 0x03 0x00 0x01 0x02 0x00 0x02 0x04 0x00 0x03 0x0e 0x00 0x04 0x83 0x00 0x05 0x82 0x00 0x06 0x84 0x00 0x07 0x8e 0x00 0x12 0x4a 0x00 0x0c 0x4b 0x00 0x14 0x4c 0x00 0x0d 0x41 0x00 0x0e 0xca 0x00 0x0f 0xcb 0x00 0x10 0xcc 0x00 0x11 0xc1 0x00 0x08 0x05 0x00 0x09 0x46 0x01 0x16 0x27 0x00 0x17 0x29 0x01>;
			};

			qm42195_qm45197 {
				mapping = <0x00 0x03 0x00 0x01 0x02 0x00 0x02 0x04 0x00 0x04 0x83 0x00 0x05 0x82 0x00 0x06 0x84 0x00 0x12 0x4a 0x00 0x0c 0x4b 0x00 0x14 0x4c 0x00 0x0e 0xca 0x00 0x0f 0xcb 0x00 0x10 0xcc 0x00>;
			};
		};
	};

	fragment@62 {
		target = <&connv3>;

		__overlay__ {
			status = "okay";
			compatible = "xring,f1-connv3";
			pinctrl-0 = <&{/fragment@58/__overlay__/gpio_115_init}>;
			pinctrl-1 = <&{/fragment@58/__overlay__/gpio_115_default}>;
			pinctrl-2 = <&{/fragment@58/__overlay__/gpio_115_init}>;
			pinctrl-3 = <&{/fragment@58/__overlay__/gpio_003_init}>;
			pinctrl-4 = <&{/fragment@58/__overlay__/gpio_003_default}>;
			pinctrl-5 = <&{/fragment@58/__overlay__/gpio_115_sleep}>;
			pinctrl-6 = <&{/fragment@58/__overlay__/gpio_003_sleep}>;
			pinctrl-7 = <&{/fragment@58/__overlay__/uart1_4_txd_init}>;
			pinctrl-8 = <&{/fragment@58/__overlay__/uart1_4_txd_default}>;
			pinctrl-9 = <&{/fragment@58/__overlay__/uart1_4_txd_sleep}>;
			pinctrl-10 = <&{/fragment@58/__overlay__/uart1_4_rxd_init}>;
			pinctrl-11 = <&{/fragment@58/__overlay__/uart1_4_rxd_default}>;
			pinctrl-12 = <&{/fragment@58/__overlay__/uart1_4_rxd_sleep}>;
			pinctrl-13 = <&{/fragment@58/__overlay__/uart1_4_txd_pre}>;
			pinctrl-14 = <&{/fragment@58/__overlay__/uart1_4_rxd_pre}>;
			#interrupt-parent = <&dw_gpio0>;
			pmic-gpio = <&dw_gpio0>, <0x03 0x00>, <&dw_gpio4>, <0x02 0x00>;
			#interrupts = <0x01 0x02>;
			clocks = <&xr_clk>, <0x1df>;
			clock-names = "clk_32k_o2";
		};
	};

	fragment@63 {
		target = <&xiaomi_wifi_gpio>;

		__overlay__ {
			status = "okay";
			compatible = "wlan,xiaomi_wifi_gpio";
			status-gpio = <&dw_gpio1>, <0x07 0x00>;
			debounce-time = <0x1e>;
			pinctrl-names = "default";
			pinctrl-0 = <&{/fragment@58/__overlay__/gpio_039_default}>;
		};
	};

	fragment@64 {
		target-path = "/";

		__overlay__ {

			heap_test {
				compatible = "xring,heap_test";
				status = "okay";
			};

			media1_vdec_smmu_test {
				compatible = "xring,smmu_test";
				status = "okay";
				smmu_test = "media1_vdec";
				iommus = <&media1_smmu>, <0x20 0x20>;

				iova-info {
					iova-reserve = <0x00 0x00 0x00 0x40000000>;
				};
			};

			media2_venc_smmu_test {
				compatible = "xring,smmu_test";
				status = "okay";
				smmu_test = "media2_venc";
				iommus = <&media2_smmu>, <0x21 0x21>;

				iova-info {
					iova-reserve = <0x00 0x00 0x00 0x40000000>;
				};
			};

			pcie_smmu_test {
				compatible = "xring,smmu_test";
				status = "disabled";
				smmu_test = "hss2_pcie";
				iommus = <&pcie_smmu>, <0x22 0x22>;

				iova-info {
					iova-reserve = <0x00 0x00 0x00 0x40000000>;
				};
			};
		};
	};

