	fragment@75 {
		target-path = "/";

		__overlay__ {

			mca_xring_usb {
				status = "okay";
				compatible = "mca,mca_xring_usb";
				xr-usb = <&usb>;
			};
		};
	};

	fragment@76 {
		target = <&dw_i2c6>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-frequency = <0x61a80>;

			xm_subpmic_sc6601a {
				#io-channel-cells = <0x01>;
				compatible = "xm_subpmic_sc6601a,subpmic_core";
				reg = <0x61>;
				sc6601-gpio = <&dw_gpio2>, <0x08 0x00>;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				pinctrl-names = "default";
				pinctrl-0 = <&{/fragment@58/__overlay__/gpio_072_default}>;

				xm_subpmic_sc6601a_drv {
					#io-channel-cells = <0x01>;
					compatible = "xm_subpmic_sc6601a,subpmic_drv";
					vbusp-gpio = <&dw_gpio6>, <0x1d 0x00>;
					otg_boost_src = <0x01>;
					otg_boost_en = <&dw_gpio6>, <0x1b 0x00>;
					otg_en = <&dw_gpio7>, <0x0e 0x00>;
					pinctrl-names = "default";
					pinctrl-0 = <&{/fragment@58/__overlay__/otg_boost_en_default}>, <&{/fragment@58/__overlay__/otg_en_default}>;
					interrupts = <0x06 0x00 0x03>;
					interrupt-names = "Hourse Keeping", "Buck Charger", "DPDM";
					sc,vsys-limit = <0xdac>;
					sc,batsnc-enable = <0x01>;
					sc,vbat = <0x11b0>;
					sc,charge-curr = <0xfa0>;
					sc,iindpm-disable = <0x00>;
					sc,input-curr-limit = <0xbb8>;
					sc,ico-enable = <0x00>;
					sc,iindpm-ico = <0x64>;
					sc,vindpm = <0x1194>;
					sc,precharge-volt = <0x01>;
					sc,precharge-curr = <0xfa>;
					sc,term-en = <0x01>;
					sc,term-curr = <0x44c>;
					sc,rechg-dis = <0x01>;
					sc,rechg-dg = <0x00>;
					sc,rechg-volt = <0x00>;
					sc,boost-voltage = <0x1388>;
					sc,boost-max-current = <0x5dc>;
					sc,conv-ocp-dis = <0x00>;
					sc,tsbat-jeita-dis = <0x01>;
					sc,ibat-ocp-dis = <0x00>;
					sc,vpmid-ovp-otg-dis = <0x00>;
					sc,vbat-ovp-buck-dis = <0x00>;
					sc,ibat-ocp = <0x01>;
					sc,chg-timer = <0x03>;
					xr-usb = <&usb>;
					usb-repeater = <&{/fragment@98/__overlay__/PTN3222@4f}>;
					sc,sc660x-pd-auth-en = <0x00>;
					sc,support-batfet-irq = <0x01>;
				};

				xm_subpmic_sc6601a_cid {
					compatible = "xm_subpmic_sc6601a,subpmic_cid";
					status = "okay";
					interrupts = <0x07>;
					interrupt-names = "CID";
					cid-force-source = <0x01>;
				};
			};

			xm_subpmic_sc6601a_pd {
				#io-channel-cells = <0x01>;
				compatible = "southchip,sc660x";
				reg = <0x62>;
				sc-tcpc,name = "type_c_port0";
				sc-tcpc,role_def = <0x04>;
				sc-tcpc,rp_level = <0x01>;
				sc-tcpc,vconn_supply = <0x01>;
				sc660x,intr_gpio_num = <&dw_gpio2>, <0x07 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&{/fragment@58/__overlay__/gpio_071_default}>;

				pd-data {
					pd,vid = <0x311c>;
					pd,pid = <0x6600>;
					pd,source-cap-ext = [1c 31 00 66 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00];
					pd,sink-cap-ext = <0x1c310066 0x00 0x1000000 0x00 0x1000000 0x00>;
					pd,mfrs = "SouthChip";
					pd,charging_policy = <0x31>;
					pd,source-pdo-size = <0x01>;
					pd,source-pdo-data = <0x19064>;
					pd,sink-pdo-size = <0x01>;
					pd,sink-pdo-data = <0x190c8>;
					pd,id-vdo-size = <0x06>;
					pd,id-vdo-data = <0xd54029cf 0x00 0x17110000 0x61000000 0x00 0x41000000>;
					bat,nr = <0x01>;
					pd,country_nr = <0x00>;

					bat-info0 {
						bat,vid = <0x311c>;
						bat,pid = <0x6600>;
						bat,mfrs = "bat1";
						bat,design_cap = <0xbb8>;
					};
				};

				dpm_caps {
					local_dr_power;
					local_dr_data;
					local_usb_comm;
					local_high_cap;
					local_no_suspend;
					local_vconn_supply;
					attempt_discover_cable_dfp;
					attempt_enter_dp_mode;
					attempt_discover_cable;
					attempt_discover_id;
					attempt_discover_svid;
					pr_check = <0x00>;
					dr_check = <0x00>;
				};

				displayport {
					1st_connection = "dfp_d";
					2nd_connection = "dfp_d";
					signal,dp_v13;
					typec,receptacle;

					ufp_d {
					};

					dfp_d {
						pin_assignment,mode_c;
						pin_assignment,mode_d;
						pin_assignment,mode_e;
					};
				};
			};

			hl7603@77 {
				compatible = "hl7603";
				status = "okay";
				reg = <0x77>;
				vout_threshold = <0xd48>;
			};
		};
	};

	fragment@77 {
		target = <&dw_i2c9>;

		__overlay__ {
