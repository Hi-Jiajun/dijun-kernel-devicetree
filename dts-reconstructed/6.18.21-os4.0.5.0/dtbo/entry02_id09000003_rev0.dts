		};
	};

	fragment@61 {
		target = <&thermal_zones>;

		__overlay__ {

			ntc-ch0 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x00>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch1 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x01>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch2 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x02>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch3 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x03>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch4 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x04>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch5 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x05>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch6 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x06>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch7 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x07>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch8 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x08>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			cpub-pause {

				cooling-maps {

					cpu8_pause_cdev {
						trip = <&cpubpause_trip2>;
						cooling-device = <&cpu8_pause>, <0x01 0x01>;
					};

					cpu9_pause_cdev {
						trip = <&cpubpause_trip2>;
						cooling-device = <&cpu9_pause>, <0x01 0x01>;
					};
				};
			};

			npu-ss-max {

				cooling-maps {

					npufreq_cdev {
						trip = <&npu_trip1>;
						cooling-device = <&npufreq>, <0xffffffff 0xffffffff>;
					};
				};
			};

			gpu-ss-max {

				cooling-maps {

					gpufreq_cdev {
						trip = <&gpu_trip1>;
						cooling-device = <&gpufreq>, <0xffffffff 0xffffffff>;
					};
				};
			};

			shell-thermal {

				cooling-maps {

					map1 {
						trip = <&shell_target>;
						cooling-device = <&CPU0>, <0xffffffff 0x04>, <&CPU2>, <0xffffffff 0x05>, <&CPU4>, <0xffffffff 0x0d>;
						contribution = <0x800>;
					};

					map2 {
						trip = <&shell_target>;
						cooling-device = <&CPU8>, <0xffffffff 0xffffffff>;
						contribution = <0x400>;
					};
				};
			};

			soc-hp {

				cooling-maps {

					cpu8_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&cpu8_hotplug>, <0x01 0x01>;
					};

					cpu9_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&cpu9_hotplug>, <0x01 0x01>;
					};

					gpu_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&gpu_hotplug>, <0xffffffff 0xffffffff>;
					};
				};
			};
		};
	};

	fragment@62 {
		target-path = "/";

		__overlay__ {

			thermal-message {
				board-sensor = "VIRTUAL-SENSOR-ERROR";
				init-thermal-sensor = "cpu-8";
			};
		};
	};

	fragment@63 {
		target = <&chosen>;

		__overlay__ {
			bootargs_ext = " ";
		};
	};

	fragment@64 {
		target = <&ufs>;

		__overlay__ {
			status = "okay";
			is_asic = <0x01>;
			xring,ufs-mphy-fw-sram-init = <0x01>;
		};
	};

	fragment@65 {
		target = <&dw_mmc>;

		__overlay__ {
			status = "disabled";
			clocks = <&xr_clk>, <0x39>, <&xr_clk>, <0x35>;
		};
	};

	fragment@66 {
		target = <&dw_i2c0>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0xf4240>;
			pinctrl-names = "init", "default", "sleep";
			pinctrl-0 = <&{/fragment@48/__overlay__/i2c0_scl_init}>, <&{/fragment@48/__overlay__/i2c0_sda_init}>;
			pinctrl-1 = <&{/fragment@48/__overlay__/i2c0_scl_default}>, <&{/fragment@48/__overlay__/i2c0_sda_default}>;
			pinctrl-2 = <&{/fragment@48/__overlay__/i2c0_scl_sleep}>, <&{/fragment@48/__overlay__/i2c0_sda_sleep}>;
		};
	};

	fragment@67 {
		target = <&dw_i2c2>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			pinctrl-names = "init", "default", "sleep";
			pinctrl-0 = <&{/fragment@48/__overlay__/i2c2_scl_init}>, <&{/fragment@48/__overlay__/i2c2_sda_init}>;
			pinctrl-1 = <&{/fragment@48/__overlay__/i2c2_scl_default}>, <&{/fragment@48/__overlay__/i2c2_sda_default}>;
			pinctrl-2 = <&{/fragment@48/__overlay__/i2c2_scl_sleep}>, <&{/fragment@48/__overlay__/i2c2_sda_sleep}>;
		};
	};

