					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			gpio_003_init {
				phandle = <0x116>;

				mux {
					pins = "PAD_GPIO_003";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_003";
					bias-pull-down;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			gpio_003_default {
				phandle = <0x117>;

				mux {
					pins = "PAD_GPIO_003";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_003";
					bias-pull-up;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			gpio_003_sleep {
				phandle = <0x119>;

				mux {
					pins = "PAD_GPIO_003";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_003";
					bias-pull-up;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			gpio_004_init {

				mux {
					pins = "PAD_GPIO_004";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_004";
					bias-pull-down;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};

			gpio_004_default {

				mux {
					pins = "PAD_GPIO_004";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_004";
					bias-pull-up;
					drive-strength = <0x01>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
