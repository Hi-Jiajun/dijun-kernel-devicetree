/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#size-cells = <0x02>;
	#address-cells = <0x02>;
	model = "XiaoMi Xring_o1 Basic";
	compatible = "XiaoMi,Xring_o1-basic";

	vote_mng_lpctrl: vote_mng@e0106000 {
		compatible = "xring,vote_mng";
		reg = <0x00 0xe0106000 0x00 0x1000>;
		phandle = <0x10b>;

		m1_arbiter_lpctrl: m1_arbiter_lpctrl {
			compatible = "xring,vote_mng_m1_arbiter";
			regs = <0x00 0x04 0x18>;
			size = <0x10 0x10>;
			arb_num = <0x08>;
			ch_num = <0x08>;
			core = <0x03>;
			phandle = <0x36>;
		};

		m2_arbiter_lpctrl: m2_arbiter_lpctrl {
			compatible = "xring,vote_mng_m2_arbiter";
			regs = <0x124 0x128 0x12c>;
			size = <0xc0 0x0c>;
			arb_num = <0x04>;
			ch_num = <0x09>;
			core = <0x03>;
			phandle = <0x9f>;
		};

		m3_arbiter_lpctrl: m3_arbiter_lpctrl {
			compatible = "xring,vote_mng_m3_arbiter";
			regs = <0x700 0x704 0x00>;
			size = <0x10 0x10>;
			arb_num = <0x06>;
			ch_num = <0x08>;
			core = <0x03>;
			phandle = <0xfd>;
		};
	};

	vote_mng_xctrlcpu: vote_mng@eb010000 {
		compatible = "xring,vote_mng";
		reg = <0x00 0xeb010000 0x00 0x1000>;
		phandle = <0x10c>;

		m1_arbiter_xctrlcpu: m1_arbiter_xctrlcpu {
			compatible = "xring,vote_mng_m1_arbiter";
			regs = <0x00 0x04 0x18>;
			size = <0x10 0x10>;
			arb_num = <0x05>;
			ch_num = <0x05>;
			core = <0x01>;
			phandle = <0x35>;
		};

		m2_arbiter_xctrlcpu: m2_arbiter_xctrlcpu {
			compatible = "xring,vote_mng_m2_arbiter";
			regs = <0x124 0x128 0x12c>;
			size = <0xc0 0x0c>;
			arb_num = <0x09>;
			ch_num = <0x09>;
			core = <0x01>;
			phandle = <0x33>;
		};

		m3_arbiter_xctrlcpu: m3_arbiter_xctrlcpu {
			compatible = "xring,vote_mng_m3_arbiter";
			regs = <0x790 0x794 0x00>;
			size = <0x10 0x10>;
			arb_num = <0x07>;
			ch_num = <0x08>;
			core = <0x01>;
			phandle = <0xa3>;
		};
	};

	vote_mng_xctrlddr: vote_mng@c0003000 {
		compatible = "xring,vote_mng";
		reg = <0x00 0xc0003000 0x00 0x1000>;
		phandle = <0x10d>;

		m1_arbiter_xctrlddr: m1_arbiter_xctrlddr {
			compatible = "xring,vote_mng_m1_arbiter";
			regs = <0x00 0x04 0x18>;
			size = <0x10 0x10>;
			arb_num = <0x05>;
			ch_num = <0x05>;
			core = <0x02>;
			phandle = <0xa1>;
		};

		m2_arbiter0_xctrlddr: m2_arbiter0_xctrlddr {
			compatible = "xring,vote_mng_m2_arbiter";
			type = <0x01>;
			regs = <0x124 0x128 0x12c>;
			size = <0xc0 0x0c>;
			arb_num = <0x02>;
			ch_num = <0x09>;
			core = <0x02>;
			phandle = <0x10e>;
		};

		m2_arbiter1_xctrlddr: m2_arbiter1_xctrlddr {
			compatible = "xring,vote_mng_m2_arbiter";
			regs = <0x2a4 0x2a8 0x2ac>;
			size = <0xc0 0x0c>;
			arb_num = <0x01>;
			ch_num = <0x0c>;
			core = <0x02>;
			phandle = <0x02>;
		};

		m3_arbiter_xctrlddr: m3_arbiter_xctrlddr {
			compatible = "xring,vote_mng_m3_arbiter";
			regs = <0x700 0x704 0x00>;
			size = <0x10 0x10>;
			arb_num = <0x02>;
			ch_num = <0x08>;
			core = <0x02>;
			phandle = <0x10f>;
		};
	};

	vote_mng_test: vote_mng_test {
		compatible = "xring,vote_mng_test";
		vote-mngs = <0x02 0x00>;
		vote-mng-names = "vote_mng_test";
		status = "disabled";
		phandle = <0x110>;
	};

	cpus: cpus {
		#size-cells = <0x00>;
		#address-cells = <0x02>;
		phandle = <0x111>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x03>;
				};

				core1 {
					cpu = <0x04>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x05>;
				};

				core1 {
					cpu = <0x06>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x07>;
				};

				core1 {
					cpu = <0x08>;
				};

				core2 {
					cpu = <0x09>;
				};

				core3 {
					cpu = <0x0a>;
				};
			};

			cluster3 {

				core0 {
					cpu = <0x0b>;
				};

				core1 {
					cpu = <0x0c>;
				};
			};
		};

		agent-irq {
			wakeup = <0x1b>;
			broadcast = <0x14b>;
		};

		idle-states {
			entry-method = "psci";

			CPU_SLEEP_L: cpu-sleep-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0xd2>;
				exit-latency-us = <0x186>;
				min-residency-us = <0xf50>;
				phandle = <0x25>;
			};

			CPU_SLEEP_ML: cpu-sleep-ml {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x8c>;
				exit-latency-us = <0x118>;
				min-residency-us = <0x370>;
				phandle = <0x27>;
			};

			CPU_SLEEP_M: cpu-sleep-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x5a>;
				exit-latency-us = <0x122>;
				min-residency-us = <0x24e>;
				phandle = <0x29>;
			};

			CPU_SLEEP_B: cpu-sleep-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x3c>;
				exit-latency-us = <0xb4>;
				min-residency-us = <0x168>;
				phandle = <0x2b>;
			};
		};

		domain-idle-states {

			CLUSTER_SLEEP_L: cluster-sleep-l {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1010000>;
				local-timer-stop;
				entry-latency-us = <0x19a>;
				exit-latency-us = <0x4e2>;
				min-residency-us = <0x259e>;
				phandle = <0x2d>;
			};

			CLUSTER_SLEEP_ML: cluster-sleep-ml {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1010000>;
				local-timer-stop;
				entry-latency-us = <0x28a>;
				exit-latency-us = <0x2ee>;
				min-residency-us = <0x834>;
				phandle = <0x2f>;
			};

			CLUSTER_SLEEP_M: cluster-sleep-M {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1010000>;
				local-timer-stop;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x352>;
				min-residency-us = <0x672>;
				phandle = <0x30>;
			};

			CLUSTER_SLEEP_B: cluster-sleep-B {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1010000>;
				local-timer-stop;
				entry-latency-us = <0x226>;
				exit-latency-us = <0x320>;
				min-residency-us = <0xece>;
				phandle = <0x31>;
			};

			SYSTEM_SLEEP: system-sleep {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x2010000>;
				local-timer-stop;
				entry-latency-us = <0x4e20>;
				exit-latency-us = <0x4e20>;
				min-residency-us = <0x7fffffff>;
				phandle = <0x32>;
			};
		};

		CPU0: cpu@0 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			xring,amu = <0xeb290000>;
			xring,dse = <0x00>;
			enable-method = "psci";
			power-domains = <0x0d>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x16a>;
			operating-points-v2 = <0x0e>;
			next-level-cache = <0x0f>;
			#cooling-cells = <0x02>;
			phandle = <0x03>;

			L2_0: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x10>;
				phandle = <0x0f>;

				L3_0: l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <0x03>;
					phandle = <0x10>;
				};
			};
		};

		CPU1: cpu@100 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x100>;
			xring,amu = <0xeb390000>;
			xring,dse = <0x00>;
			enable-method = "psci";
			power-domains = <0x11>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x16a>;
			operating-points-v2 = <0x0e>;
			next-level-cache = <0x0f>;
			#cooling-cells = <0x02>;
			phandle = <0x04>;
		};

		CPU2: cpu@200 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x200>;
			xring,amu = <0xeb490000>;
			xring,dse = <0x01>;
			enable-method = "psci";
			power-domains = <0x12>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x214>;
			operating-points-v2 = <0x13>;
			next-level-cache = <0x14>;
			#cooling-cells = <0x02>;
			phandle = <0x05>;

			L2_2: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x10>;
				phandle = <0x14>;
			};
		};

		CPU3: cpu@300 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x300>;
			xring,amu = <0xeb590000>;
			xring,dse = <0x01>;
			enable-method = "psci";
			power-domains = <0x15>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x214>;
			operating-points-v2 = <0x13>;
			next-level-cache = <0x16>;
			#cooling-cells = <0x02>;
			phandle = <0x06>;

			L2_3: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x10>;
				phandle = <0x16>;
			};
		};

		CPU4: cpu@400 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x400>;
			xring,amu = <0xeb690000>;
			xring,dse = <0x01>;
			enable-method = "psci";
			power-domains = <0x17>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x214>;
			operating-points-v2 = <0x18>;
			next-level-cache = <0x19>;
			#cooling-cells = <0x02>;
			phandle = <0x07>;

			L2_4: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x10>;
				phandle = <0x19>;
			};
		};

		CPU5: cpu@500 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x500>;
			xring,amu = <0xeb790000>;
			xring,dse = <0x01>;
			enable-method = "psci";
			power-domains = <0x1a>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x214>;
			operating-points-v2 = <0x18>;
			next-level-cache = <0x1b>;
			#cooling-cells = <0x02>;
			phandle = <0x08>;

			L2_5: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x10>;
				phandle = <0x1b>;
			};
		};

		CPU6: cpu@600 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x600>;
			xring,amu = <0xeb890000>;
			xring,dse = <0x01>;
			enable-method = "psci";
			power-domains = <0x1c>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x214>;
			operating-points-v2 = <0x18>;
			next-level-cache = <0x1d>;
			#cooling-cells = <0x02>;
			phandle = <0x09>;

			L2_6: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x10>;
				phandle = <0x1d>;
			};
		};

		CPU7: cpu@700 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x700>;
			xring,amu = <0xeb990000>;
			xring,dse = <0x01>;
			enable-method = "psci";
			power-domains = <0x1e>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x214>;
			operating-points-v2 = <0x18>;
			next-level-cache = <0x1f>;
			#cooling-cells = <0x02>;
			phandle = <0x0a>;

			L2_7: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x10>;
				phandle = <0x1f>;
			};
		};

		CPU8: cpu@800 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x800>;
			xring,amu = <0xeba90000>;
			xring,dse = <0x01>;
			enable-method = "psci";
			power-domains = <0x20>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x22e>;
			operating-points-v2 = <0x21>;
			next-level-cache = <0x22>;
			#cooling-cells = <0x02>;
			phandle = <0x0b>;

			L2_8: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x10>;
				phandle = <0x22>;
			};
		};

		CPU9: cpu@900 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x900>;
			xring,amu = <0xebb90000>;
			xring,dse = <0x01>;
			enable-method = "psci";
			power-domains = <0x23>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x22e>;
			operating-points-v2 = <0x21>;
			next-level-cache = <0x24>;
			#cooling-cells = <0x02>;
			phandle = <0x0c>;

			L2_9: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x10>;
				phandle = <0x24>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		CPU_PD0: power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x25>;
			power-domains = <0x26>;
			phandle = <0x0d>;
		};

		CPU_PD1: power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x25>;
			power-domains = <0x26>;
			phandle = <0x11>;
		};

		CPU_PD2: power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x27>;
			power-domains = <0x28>;
			phandle = <0x12>;
		};

		CPU_PD3: power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x27>;
			power-domains = <0x28>;
			phandle = <0x15>;
		};

		CPU_PD4: power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x29>;
			power-domains = <0x2a>;
			phandle = <0x17>;
		};

		CPU_PD5: power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x29>;
			power-domains = <0x2a>;
			phandle = <0x1a>;
		};

		CPU_PD6: power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x29>;
			power-domains = <0x2a>;
			phandle = <0x1c>;
		};

		CPU_PD7: power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x29>;
			power-domains = <0x2a>;
			phandle = <0x1e>;
		};

		CPU_PD8: power-domain-cpu8 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x2b>;
			power-domains = <0x2c>;
			phandle = <0x20>;
		};

		CPU_PD9: power-domain-cpu9 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x2b>;
			power-domains = <0x2c>;
			phandle = <0x23>;
		};

		CLUSTER_PD0: power-domain-cluster0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x2d>;
			power-domains = <0x2e>;
			phandle = <0x26>;
		};

		CLUSTER_PD1: power-domain-cluster1 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x2f>;
			power-domains = <0x2e>;
			phandle = <0x28>;
		};

		CLUSTER_PD2: power-domain-cluster2 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x30>;
			power-domains = <0x2e>;
			phandle = <0x2a>;
		};

		CLUSTER_PD3: power-domain-cluster3 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x31>;
			power-domains = <0x2e>;
			phandle = <0x2c>;
		};

		SYSTEM_PD: power-domain-system {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x32>;
			phandle = <0x2e>;
		};
	};

	domain_idle_gov: domain-idle-gov {
		compatible = "xring,domain-idle-gov";
		phandle = <0x112>;

		cpul-domain {
			power-domains = <0x26>;
			xring,type = "cluster";
			xring,predict-enabled;
		};

		cpuml-domain {
			power-domains = <0x28>;
			xring,type = "cluster";
			xring,predict-enabled;
		};

		cpum-domain {
			power-domains = <0x2a>;
			xring,type = "cluster";
			xring,predict-enabled;
		};

		cpub-domain {
			power-domains = <0x2c>;
			xring,type = "cluster";
			xring,predict-enabled;
		};

		sys-domain {
			power-domains = <0x2e>;
			xring,type = "system";
		};
	};

	l_opp_table: opp_table@0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x0e>;

		opp-0 {
			opp-hz = <0x00 0x13ebf1f0>;
			opp-microvolt = <0x86470>;
			opp-microwatt = <0x6978>;
			opp-supported-hw = <0x0f>;
		};

		opp-1 {
			opp-hz = <0x00 0x18e6f830>;
			opp-microvolt = <0x86470>;
			opp-microwatt = <0x7724>;
			opp-supported-hw = <0x0f>;
		};

		opp-2 {
			opp-hz = <0x00 0x21340fa0>;
			opp-microvolt = <0x86470>;
			opp-microwatt = <0x8e30>;
			opp-supported-hw = <0x0f>;
		};

		opp-3 {
			opp-hz = <0x00 0x26567400>;
			opp-microvolt = <0x86470>;
			opp-microwatt = <0x9c40>;
			opp-supported-hw = <0x0f>;
		};

		opp-4 {
			opp-hz = <0x00 0x31c82400>;
