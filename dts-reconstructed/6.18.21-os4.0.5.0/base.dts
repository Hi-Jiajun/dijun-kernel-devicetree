		xrse_dfx: xrse_dfx {
			compatible = "xring,xrse_dfx";
			xrse_boot_retry_offset_addr = <0x7d0>;
			xrse_log_base_addr = "C^0";
			xrse_log_size = <0x20000>;
			interrupt-parent = <0x01>;
			irq-num = <0x05>;
			interrupts = <0x00 0x24 0x04 0x00 0x25 0x04 0x00 0x26 0x04 0x00 0x27 0x04 0x00 0x1c5 0x04>;
			irq_name = "sensor_intr", "shield_intr", "sysrst_intr", "lockup_intr", "wdt_intr";
			irq_modeid = <0xc0001105 0xc0001106 0xc0001101 0xc0001104 0xc0001103>;
			aggregated_irq = <0x00 0x00 0x00 0x00 0x00>;
			bit_mask = <0x00 0x00 0x00 0x00 0x00>;
			irq_status_addr = <0x00 0x00 0x00 0x00 0x00>;
			vc_id = <0x24>;
			xring,dfx-upload-mode = "mievent";
			xring,enable-boot-retry;
			phandle = <0x257>;
