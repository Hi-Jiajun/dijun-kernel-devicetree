	fragment@68 {
		target-path = "/";

		__overlay__ {

			mca_xring_usb: mca_xring_usb {
				status = "okay";
				compatible = "mca,mca_xring_usb";
				otg_boost_src = <0x00>;
				xr-usb = <&usb>;
				mca_log_not_init;
				phandle = <0x2f3>;
			};
		};
	};

