	fragment@59 {
		target = <&xring_vpu_vdec>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@60 {
		target = <&xring_vpu_venc>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@61 {
		target = <&media1_smmu>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@62 {
		target = <&tsensor>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@63 {
		target = <&ntc_sensor>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@64 {
		target = <&virttsens>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@65 {
		target = <&thermal_zones>;

		__overlay__ {

			ntc-ch0 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x00>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch1 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x01>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch2 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x02>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch3 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x03>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch4 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x04>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch5 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x05>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch6 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x06>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch7 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x07>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch8 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x08>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			cpub-pause {

				cooling-maps {

					cpu8_pause_cdev {
						trip = <&cpubpause_trip2>;
						cooling-device = <&cpu8_pause>, <0x01 0x01>;
					};

					cpu9_pause_cdev {
						trip = <&cpubpause_trip2>;
						cooling-device = <&cpu9_pause>, <0x01 0x01>;
					};
				};
			};

			npu-ss-max {

				cooling-maps {

					npufreq_cdev {
						trip = <&npu_trip1>;
						cooling-device = <&npufreq>, <0xffffffff 0xffffffff>;
					};
				};
			};

			gpu-ss-max {

				cooling-maps {

					gpufreq_cdev {
						trip = <&gpu_trip1>;
						cooling-device = <&gpufreq>, <0xffffffff 0xffffffff>;
					};
				};
			};

			shell-thermal {

				cooling-maps {

					map1 {
						trip = <&shell_target>;
						cooling-device = <&CPU0>, <0xffffffff 0x04>, <&CPU2>, <0xffffffff 0x05>, <&CPU4>, <0xffffffff 0x0d>;
						contribution = <0x800>;
					};

					map2 {
						trip = <&shell_target>;
						cooling-device = <&CPU8>, <0xffffffff 0xffffffff>;
						contribution = <0x400>;
					};
				};
			};

			soc-hp {

				cooling-maps {

					cpu8_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&cpu8_hotplug>, <0x01 0x01>;
					};

					cpu9_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&cpu9_hotplug>, <0x01 0x01>;
					};

					gpu_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&gpu_hotplug>, <0xffffffff 0xffffffff>;
					};
				};
			};
		};
	};

	fragment@66 {
		target-path = "/";

		__overlay__ {

			thermal-message {
				board-sensor = "VIRTUAL-SENSOR-ERROR";
			};
		};
	};

	fragment@67 {
		target-path = "/";

		__overlay__ {

			mca_panel: mca_panel {
				compatible = "mca,mca_panel";
				status = "okay";
				phandle = <0x2cd>;
			};

			mca_bc12_class: mca_bc12_class {
				compatible = "mca,bc12_class";
				status = "okay";
				phandle = <0x2ce>;
			};

			mca_qcom_subpmic_proxy: mca_qcom_subpmic_proxy {
				compatible = "mca,qcom_subpmic";
				qcom,shutdown-voltage = <0xd16>;
				status = "disabled";
				phandle = <0x2cf>;
			};

			mca_subpmic_sysfs: mca_subpmic_sysfs {
				compatible = "mca,subpmic_sysfs";
				status = "okay";
				phandle = <0x2d0>;
			};

			mca_protocol_core: mca_protocol_core {
				compatible = "mca,protocol_core";
				status = "okay";
				phandle = <0x2d1>;
			};

			mca_protocol_pd_class: mca_protocol_pd_class {
				compatible = "mca,protocol_pd";
				status = "okay";
				max_power = <0x5a>;
				phandle = <0x2d2>;
			};

			mca_qcom_pd_protocol: mca_qcom_pd_protocol {
				compatible = "mca,adsp_pd_protocol";
				status = "disabled";
				phandle = <0x2d3>;
			};

			mca_protocol_qc_class: mca_protocol_qc_class {
				compatible = "mca,protocol_qc";
				status = "okay";
				phandle = <0x2d4>;
			};

			mca_buckchg_jeita: mca_buckchg_jeita {
				compatible = "mca,buckchg_jeita";
				volt_para1 = "4200", "670", "4500", "450";
				volt_para2 = "4200", "900", "4500", "670";
				volt_para3 = "4200", "1350", "4500", "900";
				jeita_para = "-65535", "-10", "0", "2", "0", "4535", "500", "null", "-10", "0", "1", "2", "882", "4535", "294", "para_n10_0", "0", "5", "1", "2", "1176", "4535", "294", "para_0_5", "5", "10", "1", "2", "1764", "4535", "294", "para_5_10", "10", "15", "1", "2", "4000", "4515", "294", "null", "15", "48", "2", "2", "4000", "4515", "294", "null", "48", "60", "2", "2", "2940", "4060", "294", "null", "60", "65535", "2", "2", "0", "4060", "230", "null";
				status = "disabled";
				sdp_decrease_vi_term = <0x00 0x00>;
				high_tbat_stop_chg_fv = <0x1004>;
				para_n10_0 = "4200", "882", "4535", "588";
				para_0_5 = "4200", "1176", "4535", "882";
				para_5_10 = "4200", "1764", "4535", "1176";
				jeita_para_ffc = "15", "35", "2", "2", "4000", "4580", "1529", "null", "35", "40", "2", "2", "4000", "4580", "1764", "null", "40", "48", "2", "2", "4000", "4580", "2000", "null";
				phandle = <0x2d5>;
			};

			mca_strategy_buckchg_class: mca_strategy_buckchg_class {
				compatible = "mca,strategy_buckchg";
				vbat_fg_to_pmic_ratio = <0x02>;
				vote_buck_vterm_buf = <0x00>;
				vote_buck_iterm_buf = <0x00>;
				sw_cv_vterm_th = <0x10cc>;
				support_multi_buck = <0x00>;
				in_dcp = <0x5dc>;
				in_pd = <0x640>;
				in_hvdcp = <0x4b0>;
				in_hvdcp3 = <0x640>;
				in_hvdcp3p5 = <0x640>;
				in_cdp = <0x5dc>;
				in_sdp = <0x1f4>;
				in_float = <0x3e8>;
				chg_dcp = <0x7d0>;
				chg_pd = <0xbb8>;
