/dts-v1/;
/plugin/;

/ {
	board_id = <0x9000002>;
	board_rev = <0x00>;

	fragment@0 {
		target-path = "/";

		__overlay__ {
			model = "XiaoMi Xring_o1 UDP PAD";
			compatible = "XiaoMi,Xring_o1-udp-pad";
			#size-cells = <0x02>;
			#address-cells = <0x02>;
		};
	};

	fragment@1 {
		target = <&usb>;

		__overlay__ {
			u3-eye-param-host = <0x9600 0xc0007e00 0x80032608 0x7f>;
			u3-eye-param-device = <0x9600 0xc0007e00 0x80032608 0x7f>;
		};
	};

	fragment@2 {
		target = <&dwc3>;

		__overlay__ {
			snps,usb3_lpm_capable;
			snps,dis_enblslpm_quirk;
			snps,usb2-gadget-lpm-disable;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			maximum-speed = "super-speed-plus";
		};
	};

	fragment@3 {
		target = <&bt>;

		__overlay__ {
			sleep-en = <0x01>;
			hub-en = <0x00>;
			baudrate = <0xb71b00>;
			flavor-bin = "x12_dx3";
			bt-gpio = <&dw_gpio1>, <0x05 0x00>;
			pinctrl-0 = <&uart3_4_txd_init>;
			pinctrl-1 = <&uart3_4_rxd_init>;
			pinctrl-2 = <&uart3_4_cts_init>;
			pinctrl-3 = <&uart3_4_rts_init>;
			pinctrl-4 = <&uart3_4_txd_default>;
			pinctrl-5 = <&uart3_4_rxd_default>;
			pinctrl-6 = <&uart3_4_cts_default>;
			pinctrl-7 = <&uart3_4_rts_default>;
			pinctrl-8 = <&gpio_114_default>;
			pinctrl-9 = <&gpio_114_init>;
		};
	};

	fragment@4 {
		target-path = "/";

		__overlay__ {
			#size-cells = <0x02>;
			#address-cells = <0x02>;

			udp_memdump: memory_dump@0 {
				compatible = "xring,memory_dump";
				memory-region = <&memdump_reserve>;
				status = "okay";
				phandle = <0x16c>;
			};

			osc_384k: osc-384k {
				compatible = "fixed-clock";
				#clock-cells = <0x00>;
				clock-frequency = <0x249f000>;
				clock-output-names = "osc384k";
				phandle = <0x16d>;
			};

			mdr {
				fpga_flag = <0x00>;
			};

			uart_switch {
				status = "okay";
				reg = <0x00 0xe0009700 0x00 0x04 0x00 0xec130000 0x00 0x1000 0x00 0xe1506000 0x00 0x1000>;
				switch_mode = <0x01>;
				uart_chan_num = <0x04>;
				is_secure_reg = <0x01 0x00 0x01 0x00>;
				uart_chan_options = "lpcore", "jtag", "ap", "xctrl_cpu", "xctrl_ddr", "sensorhub", "xrse", "gpio", "ap", "ddr_mcu1", "ddr_mcu2", "ddr_mcu3", "ddr_mcu4", "gpio", "xrse", "spi2", "xctrl_ddr", "npu", "gpio", "i2c15", "xctrl_cpu", "npu", "sensorhub", "adsp", "isp";
				uart_chans = <0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x02 0x02 0x02 0x02 0x02 0x02 0x03 0x03 0x03 0x03 0x03 0x04 0x04 0x04 0x04 0x04 0x04 0x04>;
				sctrl_val = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x1000 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				sctrl_mask = <0x10000 0x00 0x20000 0x40000 0x80000 0x400000 0x200000 0x00 0x20000 0x2000000 0x2000000 0x2000000 0x2000000 0x00 0x200000 0x00 0x10080000 0x10080000 0x00 0x00 0x40000 0x100000 0x400000 0x800000 0x1000000>;
				config_val = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x00 0x01 0x02 0x03 0x04 0x05 0x00 0x01 0x02 0x03 0x03 0x00 0x01 0x02 0x03 0x04 0x05 0x06>;
				iomux_drv_cfg = <0x00 0x00 0x00 0x00 0xec13900c 0xec139008 0x18 0x10 0x00 0x00 0x00 0x00 0xe000d040 0xe000d03c 0x18 0x10>;
			};
		};
	};

	fragment@5 {
		target = <&pinctrl>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@6 {
		target = <&serial0>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@7 {
		target = <&perf_mon>;

		__overlay__ {
			status = "okay";
			memory-region = <&perf>;
			time-shift = <0xf4240>;
		};
	};

	fragment@8 {
		target = <&xring_ipc>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@9 {
		target = <&sensorhub>;

		__overlay__ {
			status = "okay";

			i3c {
				status = "okay";

				i3c1 {
					i3c-slave-num = <0x01>;
					i2c-slave-num = <0x00>;
					status = "okay";
				};
			};

			uart {
				status = "okay";

				uart0 {
					status = "okay";
				};

				uart1 {
					status = "okay";
				};

				uart2 {
					status = "okay";
				};

				uart11 {
					status = "okay";
				};
			};

			sensor_power {
				status = "okay";
				power-supply = <&lldo3>, <&mldo4>, <&hldo6>;
				power-id-volt = <0x12 0x124f80 0x18 0x1b7740 0x22 0x325aa0>;
			};
		};
	};

	fragment@10 {
		target = <&xring_firq>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@11 {
		target = <&intr_sensorhub_to_acpu>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@12 {
		target = <&pstore>;

		__overlay__ {
			compatible = "ramoops";
			record-size = <0x40000>;
			console-size = <0x80000>;
			pmsg-size = <0x40000>;
		};
	};

	fragment@13 {
		target = <&xr_kdump>;

		__overlay__ {
			status = "okay";
			memory-region = <&memdump_reserve>;
		};
	};

	fragment@14 {
		target = <&pmic>;

		__overlay__ {

			uefi_mbuck1: uefi_mbuck1 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck1";
				regulator-id = <0x00>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
				phandle = <0x16e>;
			};

			uefi_mbuck2: uefi_mbuck2 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck2";
				regulator-id = <0x01>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
				phandle = <0x16f>;
			};

			uefi_mbuck3: uefi_mbuck3 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck3";
				regulator-id = <0x02>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
				phandle = <0x170>;
			};

			uefi_mbuck4: uefi_mbuck4 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck4";
				regulator-id = <0x03>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
				phandle = <0x171>;
			};

			uefi_mbuck5: uefi_mbuck5 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck5";
				regulator-id = <0x04>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
				phandle = <0x172>;
			};

			uefi_mbuck6: uefi_mbuck6 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck6";
				regulator-id = <0x05>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
				phandle = <0x173>;
			};

			uefi_mbuck8: uefi_mbuck8 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck8";
				regulator-id = <0x07>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x149970>;
				step-uV = <0x1388>;
				phandle = <0x174>;
			};

			uefi_mbuck9: uefi_mbuck9 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mbuck9";
				regulator-id = <0x08>;
				regulator-min-microvolt = <0x41eb0>;
				regulator-max-microvolt = <0x15aae0>;
				step-uV = <0x1388>;
				phandle = <0x175>;
			};

			uefi_ulldo3: uefi_ulldo3 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "ulldo3";
				regulator-id = <0x0c>;
				regulator-min-microvolt = <0x83d60>;
				regulator-max-microvolt = <0x142440>;
				step-uV = <0x2710>;
				phandle = <0x176>;
			};

			uefi_ulldo4: uefi_ulldo4 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "ulldo4";
				regulator-id = <0x0d>;
				regulator-min-microvolt = <0x83d60>;
				regulator-max-microvolt = <0x142440>;
				step-uV = <0x2710>;
				phandle = <0x177>;
			};

			uefi_ulldo6: uefi_ulldo6 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "ulldo6";
				regulator-id = <0x0f>;
				regulator-min-microvolt = <0x83d60>;
				regulator-max-microvolt = <0x142440>;
				step-uV = <0x2710>;
				phandle = <0x178>;
			};

			uefi_lldo1: uefi_lldo1 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "lldo1";
				regulator-id = <0x10>;
				regulator-min-microvolt = <0x83d60>;
				regulator-max-microvolt = <0x142440>;
				step-uV = <0x2710>;
				phandle = <0x179>;
			};

			uefi_lldo2: uefi_lldo2 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "lldo2";
				regulator-id = <0x11>;
				regulator-min-microvolt = <0x83d60>;
				regulator-max-microvolt = <0x142440>;
				step-uV = <0x2710>;
				phandle = <0x17a>;
			};

			uefi_mldo3: uefi_mldo3 {
				compatible = "xring,uefi-pmic-regulator";
				regulator-name = "mldo3";
				regulator-id = <0x17>;
				regulator-min-microvolt = <0x192d50>;
				regulator-max-microvolt = <0x1de840>;
				step-uV = <0x2710>;
				phandle = <0x17b>;
			};

			vdd_media: vdd_media {
				compatible = "xring,regulator_lpcore";
				regulator-name = "vdd_media";
				regulator-id = <0x07>;
				vote-mngs = <&m1_arbiter_lpctrl>, <0x02>;
				vote-mng-names = "m1_mng_vdd_media";
				regulator-min-microvolt = <0x493e0>;
				regulator-max-microvolt = <0x13d620>;
				status = "disabled";
				phandle = <0x17c>;
			};
		};
	};

	fragment@15 {
		target = <&usb_adsp>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@16 {
		target = <&cpnv>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@17 {
		target-path = "/";

		__overlay__ {

			fake_dsi_panel: fake_dsi_panel {
				status = "okay";
				dsi-panel-name = "fake_dsi_panel";
				dsi-panel-id = <0x00>;
				dsi-panel-type = "dsi_video_mode";
				dsi-burst-mode = "non_burst_sync_pulses";
				dsi-panel-width = <0x5a0>;
				dsi-panel-height = <0xc80>;
				dsi-panel-backlight-setting-type = "cmd";
				dsi-panel-brightness-max-level = <0x7ff>;
				dsi-panel-brightness-min-level = <0x14>;
				dsi-panel-brightness-init-level = <0x7ff>;
				dsi-panel-phy-type = "dphy";
				dsi-panel-clk-type = "non_continuous";
				dsi-panel-lane-number = <0x04>;
				dsi-panel-lane-rate = <0x26be414e>;
				dsi-panel-pixel-clock = <0xcea270>;
				dsi-panel-bpp = <0x18>;
				dsi-panel-virtual-channel = <0x00>;
				dsi-panel-esd-check-enable;
				dsi-panel-hdr-enabled;
				dsi-panel-peak-brightness = <0x401640>;
				dsi-panel-blackness-level = <0xc9e>;
				dsi-panel-physical-width-dimension = <0x2bd>;
				dsi-panel-physical-height-dimension = <0x616>;
				dsi-panel-physical-type = "ltpo";
				dsi-panel-te-sel = [00];
				dsi-panel-port-mask = [01];
				dsi-panel-boot-up-profile = <0x01>;
				dsi-panel-lowpower-ctrl = <0x00>;
				dsi-panel-frame-power-mask = <0x00>;
				dsi-panel-frame-power-max-refresh-rate = <0x00>;
				dsi-panel-idle-policy = <0x00>;
				dsi-panel-dsc-compression-mode = "dsc";
				dsi-panel-dsc-version = <0x12>;
				dsi-panel-dsc-scr-version = <0x00>;
				dsi-panel-dsc-pic-height = <0xc80>;
				dsi-panel-dsc-pic-width = <0x5a0>;
				dsi-panel-dsc-slice-height = <0x14>;
				dsi-panel-dsc-slice-width = <0x2d0>;
				dsi-panel-dsc-bpc = [0a];
				dsi-panel-dsc-bpp = [08];
				phandle = <0x1d>;

				dsi-display-timings {

					default_index_00 {
						dsi-panel-frame-rate = <0x3c>;
						dsi-panel-vrr-type = <0x00>;
						dsi-panel-width = <0x5a0>;
						dsi-panel-height = <0xc80>;
						dsi-panel-h-front-porch = <0x10>;
						dsi-panel-h-back-porch = <0x10>;
						dsi-panel-h-pulse-width = <0x10>;
						dsi-panel-h-sync-skew = <0x00>;
						dsi-panel-v-back-porch = <0x18>;
						dsi-panel-v-front-porch = <0x40>;
						dsi-panel-v-pulse-width = <0x04>;
						dsi-panel-timing-switch-command = <0x39000040 0x226 0x3390000 0x40000002 0x2f003900 0x400000 0x22f3039 0x4000 0x6f055 0xaa520800 0x39000040 0x26f 0x1c390000 0x4000000a 0xba910101 0x10101 0x3900 0x400000 0x2bc2039 0x00 0x22c00>;
						dsi-panel-timing-switch-command-update = <0x26 0x00 0x01>;
						dsi-panel-timing-switch-command-state = "dsi_hs_mode";
