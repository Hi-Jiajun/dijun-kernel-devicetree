			pinctrl-38 = <&i2s9_sck_sleep>, <&i2s9_ws_sleep>, <&i2s9_di_sleep>, <&i2s9_do_sleep>;
			pinctrl-39 = <&i2s10_sck_init>, <&i2s10_ws_init>, <&i2s10_di_init>, <&i2s10_do_init>;
			pinctrl-40 = <&i2s10_sck_default>, <&i2s10_ws_default>, <&i2s10_di_default>, <&i2s10_do_default>;
			pinctrl-41 = <&i2s10_sck_sleep>, <&i2s10_ws_sleep>, <&i2s10_di_sleep>, <&i2s10_do_sleep>;
			pinctrl-42 = <&gpio_061_init>, <&gpio_124_init>, <&gpio_125_init>;
			pinctrl-43 = <&gpio_061_default>, <&gpio_124_default>, <&gpio_125_default>;
			pinctrl-44 = <&gpio_061_sleep>, <&gpio_124_sleep>, <&gpio_125_sleep>;
		};
	};

	fragment@47 {
		target = <&adsp_boot>;

		__overlay__ {
			device-type = <0x00>;
		};
	};

	fragment@48 {
		target-path = "/";

		__overlay__ {

			pwrctl {
				compatible = "mediatek,wwan_pwrctl";
				pmic-en = <&dw_gpio7>, <0x06 0x00>;
				pmic-rst = <&dw_gpio6>, <0x1c 0x00>;
				reset-eint = <&dw_gpio2>, <0x10 0x00>;
				md-dump = <&dw_gpio5>, <0x0a 0x00>;
				pmic-faultb = <&dw_gpio1>, <0x1b 0x00>;
				pcie-wake = <&dw_gpio1>, <0x1a 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&gpio_221_default>, <&gpio_211_default>, <&gpio_080_default>, <&gpio_155_default>, <&gpio_058_default>, <&gpio_059_default>;
			};

			gpio_sap_ctrl: gpio-sap-ctrl {
				compatible = "mediatek,gpio_sap_ctrl";
				pinctrl-names = "sap_off", "sap_download_pd", "sap_download_pu", "sap_working_pd", "sap_working_pu", "sap_working_nopull";
				pinctrl-0 = <&uart2_4_txd_init>, <&uart2_4_rxd_init>, <&uart0_4_txd_init>, <&uart0_4_rxd_init>;
				pinctrl-1 = <&uart2_4_txd_init>, <&uart2_4_rxd_init>, <&uart0_4_txd_init>, <&uart0_4_rxd_init>;
				pinctrl-2;
				pinctrl-3;
				pinctrl-4 = <&uart2_4_rxd_default>, <&uart0_4_rxd_default>;
				pinctrl-5 = <&uart2_4_txd_default>, <&uart0_4_txd_default>;
				phandle = <0x19d>;
			};

			md2ap_timetick_sync: md2ap-timetick-sync {
				compatible = "mediatek,timesync";
				mdm-gnss-sync = <&dw_gpio1>, <0x17 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&gpio_055_default>;
				phandle = <0x19e>;
			};
		};
	};

