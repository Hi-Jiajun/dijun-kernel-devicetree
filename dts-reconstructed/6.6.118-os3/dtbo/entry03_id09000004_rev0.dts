	fragment@67 {
		target = <&dw_i2c20>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			sc8585_master@6e {
				compatible = "sc8585_master";
				ic_role = <0x00>;
				reg = <0x6e>;
				cp-int = <&dw_gpio1>, <0x0f 0x00>;
				cp-nlpm-gpio = <&dw_gpio3>, <0x1a 0x00>;
				pinctrl-names = "default";
				bat-ovp-threshold = <0x122a>;
				bat-ovp-alarm-threshold = <0x11f8>;
				bus-ovp-threshold = <0x5208 0x2af8 0x1770>;
				usb-ovp-threshold = <0x5208 0x36b0 0x1964>;
				bus-ocp-threshold = <0x1194 0x1388 0x1194>;
				wpc-ovp-threshold = <0x5208>;
				out-ovp-threshold = <0x1388>;
				pmid2-uvp-threshold = <0x64>;
				pmid2-ovp-threshold = <0x258>;
			};

			bq27z561_standlone@55 {
				compatible = "ti,bq27z561_master";
				reg = <0x55>;
				status = "disabled";
			};
		};
	};

	fragment@68 {
		target = <&dw_i2c4>;

		__overlay__ {
			status = "ok";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			nu1652@41 {
				compatible = "fuda,nu1652";
				status = "disabled";
				reg = <0x41>;
				project_vendor = <0x01>;
				support-hall = <0x01>;
				rx_role = <0x00>;
				fw_version_index = <0x01>;
				pinctrl-names = "rx_int_pull_up", "hall_int_pull_up";
				rx-int = <&dw_gpio1>, <0x10 0x00>;
				pwr-det-int = <&dw_gpio2>, <0x0f 0x00>;
				sleep-rx-gpio = <&dw_gpio1>, <0x12 0x00>;
				hall-int2 = <&dw_gpio1>, <0x11 0x00>;
			};
		};
	};

