				max_vbat = <0x118a>;
				recharge_vbat_delta = <0xfa>;
				die_temp_max = <0x7d>;
				adp_temp_max = <0x7d>;
				div_delta_volt = <0x12c 0x12c 0x1f4>;
				div_single_curr = <0x1388 0x2ee0 0x3cf0>;
				div_max_curr = <0x1388 0x2ee0 0x3cf0>;
				multi_ibus_th = <0x7d0 0x5dc 0x258>;
				ibus_inc_hysteresis = <0xc8 0xc8 0x64>;
				ibus_dec_hysteresis = <0xc8 0xc8 0x64>;
				open_path_th = <0x320 0x258 0x190>;
				support_mode = <0x07>;
