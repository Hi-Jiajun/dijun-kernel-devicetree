			#size-cells = <0x00>;
			pinctrl-names = "init", "default", "sleep";
			pinctrl-0 = <&spi4_clk_init>, <&spi4_mosi_init>, <&spi4_miso_init>, <&spi4_cs_init>;
			pinctrl-1 = <&spi4_clk_default>, <&spi4_mosi_default>, <&spi4_miso_default>, <&spi4_cs_default>;
			pinctrl-2 = <&spi4_clk_sleep>, <&spi4_mosi_sleep>, <&spi4_miso_sleep>, <&spi4_cs_sleep>;
			cs-gpios = <&dw_gpio3>, <0x1d 0x01>;

			xrisp_stmvl53l8: xrisp_stmvl53l8@0 {
				status = "disable";
				compatible = "xring,stmvl53l8";
				spi-max-frequency = <0x1312d00>;
				xring,firmware_name = "com.xring.cam_tof.stmvl53l8.bin";
				reg = <0x00>;
				spi-cpol;
				spi-cpha;
				phandle = <0x19c>;
			};
		};
	};

	fragment@40 {
		target = <&spk1>;

		__overlay__ {
			status = "okay";
			reset-gpios = <&dw_gpio4>, <0x14 0x00>;
			irq-gpio = <&dw_gpio4>, <0x0b 0x00>;
			#interrupt-parent = <&dw_gpio4>;
			#interrupts = <0x0b 0x08>;
			cirrus,gpio2-src-sel = <0x02>;
		};
	};

	fragment@41 {
		target = <&spk2>;

		__overlay__ {
			status = "okay";
			reset-gpios = <&dw_gpio5>, <0x18 0x00>;
			irq-gpio = <&dw_gpio4>, <0x0c 0x00>;
			#interrupt-parent = <&dw_gpio4>;
			#interrupts = <0x0c 0x08>;
			cirrus,gpio2-src-sel = <0x02>;
		};
	};

	fragment@42 {
		target = <&cs35l41b>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@43 {
		target = <&haptic1>;

		__overlay__ {
			status = "okay";
			#cirrus,fw-defer = <0x01>;
			pinctrl-names = "default";
			pinctrl-0 = <&gpio_046_default>;
		};
	};

	fragment@44 {
		target = <&cs47l92>;

		__overlay__ {
			reset-gpios = <&dw_gpio3>, <0x00 0x00>;
			irq-gpio = <&dw_gpio1>, <0x1d 0x00>;
			interrupt-parent = <&dw_gpio1>;
			interrupts = <0x1d 0x08>;
			AVDD-supply = <&mldo8>;
			DBVDD1-supply = <&mldo8>;

			MICBIAS2 {
				cirrus,ext-cap = <0x00>;
				regulator-active-discharge = <0x01>;
				regulator-min-microvolt = <0x231860>;
				regulator-max-microvolt = <0x231860>;
			};

			cirrus,accdet {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				acc@1 {
					reg = <0x01>;
					cirrus,micd-clamp-mode = <0x00>;
					cirrus,micd-configs = <0x00 0x01 0x04 0x00 0x01>;
					cirrus,hpd-pins = <0x00 0x04 0x01 0x05>;
				};
			};
		};
	};

