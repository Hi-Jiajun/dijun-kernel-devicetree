		};
	};

	fragment@74 {
		target = <&pinctrl_configs>;

		__overlay__ {

			spi6_clk_init: spi6_clk_init {
				phandle = <0x181>;

				mux {
					pins = "PAD_GPIO_120";
					function = "SPI6";
				};

				pinconf {
					pins = "PAD_GPIO_120";
					bias-disable;
					drive-strength = <0x04>;
					slew-rate = <0x00>;
					input-schmitt-disable;
				};
			};

			spi6_clk_default: spi6_clk_default {
				phandle = <0x184>;

				mux {
					pins = "PAD_GPIO_120";
					function = "SPI6";
				};

				pinconf {
					pins = "PAD_GPIO_120";
					bias-disable;
					drive-strength = <0x04>;
					slew-rate = <0x00>;
					input-schmitt-disable;
				};
			};

			spi6_clk_sleep: spi6_clk_sleep {
				phandle = <0x187>;

				mux {
					pins = "PAD_GPIO_120";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_120";
					bias-disable;
					drive-strength = <0x04>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-low;
				};
			};

			spi6_mosi_init: spi6_mosi_init {
				phandle = <0x182>;

				mux {
					pins = "PAD_GPIO_121";
					function = "SPI6";
				};

				pinconf {
					pins = "PAD_GPIO_121";
					bias-disable;
					drive-strength = <0x04>;
					slew-rate = <0x00>;
					input-schmitt-disable;
				};
			};

			spi6_mosi_default: spi6_mosi_default {
				phandle = <0x185>;

				mux {
					pins = "PAD_GPIO_121";
					function = "SPI6";
				};

				pinconf {
					pins = "PAD_GPIO_121";
					bias-disable;
					drive-strength = <0x04>;
					slew-rate = <0x00>;
					input-schmitt-disable;
				};
			};

			spi6_mosi_sleep: spi6_mosi_sleep {
				phandle = <0x188>;

				mux {
					pins = "PAD_GPIO_121";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_121";
					bias-disable;
					drive-strength = <0x04>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					output-low;
				};
			};

			spi6_miso_init: spi6_miso_init {
				phandle = <0x183>;

				mux {
					pins = "PAD_GPIO_122";
					function = "SPI6";
				};

				pinconf {
					pins = "PAD_GPIO_122";
					bias-disable;
					drive-strength = <0x04>;
					slew-rate = <0x00>;
					input-schmitt-disable;
				};
			};

			spi6_miso_default: spi6_miso_default {
				phandle = <0x186>;

				mux {
					pins = "PAD_GPIO_122";
					function = "SPI6";
				};

				pinconf {
					pins = "PAD_GPIO_122";
					bias-disable;
					drive-strength = <0x04>;
					slew-rate = <0x00>;
					input-schmitt-disable;
				};
			};

			spi6_miso_sleep: spi6_miso_sleep {
				phandle = <0x189>;

				mux {
					pins = "PAD_GPIO_122";
					function = "GPIO";
				};

				pinconf {
					pins = "PAD_GPIO_122";
					bias-pull-down;
					drive-strength = <0x04>;
					slew-rate = <0x00>;
					input-schmitt-disable;
					input-enable;
				};
			};
		};
	};

