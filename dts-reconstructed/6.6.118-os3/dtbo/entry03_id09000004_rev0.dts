	fragment@62 {
		target = <&thermal_zones>;

		__overlay__ {

			ntc-ch0 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x00>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch1 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x01>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch2 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x02>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch3 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x03>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch4 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x04>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch5 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x05>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch6 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x06>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch7 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x07>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			ntc-ch8 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x0a>;
				thermal-sensors = <&ntc_sensor>, <0x08>;

				trips {

					trippoint1 {
						temperature = <0x186a0>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			cpub-pause {

				cooling-maps {

					cpu8_pause_cdev {
						trip = <&cpubpause_trip2>;
						cooling-device = <&cpu8_pause>, <0x01 0x01>;
					};

					cpu9_pause_cdev {
						trip = <&cpubpause_trip2>;
						cooling-device = <&cpu9_pause>, <0x01 0x01>;
					};
				};
			};

			npu-ss-max {

				cooling-maps {

					npufreq_cdev {
						trip = <&npu_trip1>;
						cooling-device = <&npufreq>, <0xffffffff 0xffffffff>;
					};
				};
			};

			gpu-ss-max {

				cooling-maps {

					gpufreq_cdev {
						trip = <&gpu_trip1>;
						cooling-device = <&gpufreq>, <0xffffffff 0xffffffff>;
					};
				};
			};

			shell-thermal {

				cooling-maps {

					map1 {
						trip = <&shell_target>;
						cooling-device = <&CPU0>, <0xffffffff 0x04>, <&CPU2>, <0xffffffff 0x05>, <&CPU4>, <0xffffffff 0x0d>;
						contribution = <0x800>;
					};

					map2 {
						trip = <&shell_target>;
						cooling-device = <&CPU8>, <0xffffffff 0xffffffff>;
						contribution = <0x400>;
					};
				};
			};

			soc-hp {

				cooling-maps {

					cpu8_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&cpu8_hotplug>, <0x01 0x01>;
					};

					cpu9_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&cpu9_hotplug>, <0x01 0x01>;
					};

					gpu_hot_cdev {
						trip = <&sochp_trip2>;
						cooling-device = <&gpu_hotplug>, <0xffffffff 0xffffffff>;
					};
				};
			};
		};
	};

	fragment@63 {
		target-path = "/";

		__overlay__ {

			thermal-message {
				board-sensor = "VIRTUAL-SENSOR-ERROR";
			};
		};
	};

	fragment@64 {
		target-path = "/";

		__overlay__ {

			mca_panel: mca_panel {
				compatible = "mca,mca_panel";
				status = "okay";
				phandle = <0x31a>;
			};

			mca_bc12_class: mca_bc12_class {
				compatible = "mca,bc12_class";
				status = "okay";
				phandle = <0x31b>;
			};

			mca_qcom_subpmic_proxy: mca_qcom_subpmic_proxy {
				compatible = "mca,qcom_subpmic";
				qcom,shutdown-voltage = <0xd16>;
				status = "disabled";
				phandle = <0x31c>;
			};

			mca_subpmic_sysfs: mca_subpmic_sysfs {
				compatible = "mca,subpmic_sysfs";
				status = "okay";
				phandle = <0x31d>;
			};

			mca_protocol_core: mca_protocol_core {
				compatible = "mca,protocol_core";
				status = "okay";
				phandle = <0x31e>;
			};

			mca_protocol_pd_class: mca_protocol_pd_class {
				compatible = "mca,protocol_pd";
				status = "okay";
				max_power = <0x5a>;
				phandle = <0x31f>;
			};

			mca_qcom_pd_protocol: mca_qcom_pd_protocol {
				compatible = "mca,adsp_pd_protocol";
