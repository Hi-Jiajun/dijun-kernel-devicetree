	fragment@50 {
		target = <&wifi>;

		__overlay__ {
			status = "okay";
			compatible = "xring,f1-wifi";
			wf-rst-gpio = <&dw_gpio4>, <0x00 0x00>;
			wf-wk-gpio = <&dw_gpio0>, <0x0c 0x00>;
			pinctrl-names = "wf_rst_off", "wf_rst_on", "wf_rst_sleep", "wf_wk_host_on", "wf_wk_host_off", "wf_wk_host_sleep";
			pinctrl-0 = <&gpio_113_init>;
			pinctrl-1 = <&gpio_113_default>;
			pinctrl-2 = <&gpio_113_sleep>;
			pinctrl-3 = <&gpio_012_default>;
			pinctrl-4 = <&gpio_012_init>;
			pinctrl-5 = <&gpio_012_sleep>;
			memory-region = <&wifi_mem>;
		};
	};

	fragment@51 {
		target = <&wifi_page_pool>;

		__overlay__ {
			status = "okay";
			compatible = "mediatek,wifi_page_pool";
			emi-size = <0x5400000>;
			dynamic-alloc = <0x01>;
			memory-region = <&wifi_page_pool_mem>;
		};
	};

	fragment@52 {
		target = <&connfem>;

		__overlay__ {
			status = "okay";
			compatible = "mediatek,mt6985-connfem";

			epa_elna {
				parts = <&qm42195>, <&qm45197>;

				common {

					flags-0 {
						rx-mode = [00];
						fe-ant-cnt = [81];
						fe-main-bt-share-lp2g = [80];
						fe-conn-spdt = [80];
						fe-reserved = [80];
					};
				};

				wifi {

					flags-0 {
						epa-option = [aa];
					};
				};

				bt {

					flags-0 {
						epa_elna;
					};
				};
			};

			qm42639: qm42639 {
				vid = <0x03>;
				pid = <0x03>;
				phandle = <0x280>;
			};

			qm45639: qm45639 {
				vid = <0x03>;
				pid = <0x04>;
				phandle = <0x281>;
			};

			qm42195: qm42195 {
				vid = <0x03>;
				pid = <0x01>;
				phandle = <0x122>;
			};

			qm45197: qm45197 {
				vid = <0x03>;
				pid = <0x02>;
				phandle = <0x123>;
			};

			qm42639_qm45639 {
				mapping = <0x00 0x03 0x00 0x01 0x02 0x00 0x02 0x04 0x00 0x03 0x0e 0x00 0x04 0x83 0x00 0x05 0x82 0x00 0x06 0x84 0x00 0x07 0x8e 0x00 0x12 0x4a 0x00 0x0c 0x4b 0x00 0x14 0x4c 0x00 0x0d 0x41 0x00 0x0e 0xca 0x00 0x0f 0xcb 0x00 0x10 0xcc 0x00 0x11 0xc1 0x00 0x08 0x05 0x00 0x09 0x46 0x01 0x16 0x27 0x00 0x17 0x29 0x01>;
			};

			qm42195_qm45197 {
				mapping = <0x00 0x03 0x00 0x01 0x02 0x00 0x02 0x04 0x00 0x04 0x83 0x00 0x05 0x82 0x00 0x06 0x84 0x00 0x12 0x4a 0x00 0x0c 0x4b 0x00 0x14 0x4c 0x00 0x0e 0xca 0x00 0x0f 0xcb 0x00 0x10 0xcc 0x00>;
			};
		};
	};

	fragment@53 {
		target = <&connv3>;

		__overlay__ {
			status = "okay";
			compatible = "xring,f1-connv3";
			pinctrl-0 = <&gpio_115_init>;
			pinctrl-1 = <&gpio_115_default>;
			pinctrl-2 = <&gpio_115_init>;
			pinctrl-3 = <&gpio_003_init>;
			pinctrl-4 = <&gpio_003_default>;
			pinctrl-5 = <&gpio_115_sleep>;
			pinctrl-6 = <&gpio_003_sleep>;
			pinctrl-7 = <&uart1_4_txd_init>;
			pinctrl-8 = <&uart1_4_txd_default>;
			pinctrl-9 = <&uart1_4_txd_sleep>;
			pinctrl-10 = <&uart1_4_rxd_init>;
			pinctrl-11 = <&uart1_4_rxd_default>;
			pinctrl-12 = <&uart1_4_rxd_sleep>;
			pinctrl-13 = <&uart1_4_txd_pre>;
			pinctrl-14 = <&uart1_4_rxd_pre>;
			#interrupt-parent = <&dw_gpio0>;
			pmic-gpio = <&dw_gpio0>, <0x03 0x00>, <&dw_gpio4>, <0x02 0x00>;
			#interrupts = <0x01 0x02>;
			clocks = <&xr_clk>, <0x1df>;
			clock-names = "clk_32k_o2";
		};
	};

	fragment@54 {
		target-path = "/";

		__overlay__ {

			xring_smmu_dma_test: xring_smmu_dma_test {
				compatible = "xring,smmu_dma_test";
				status = "okay";
				iommus = <&media1_smmu>, <0x23 0x23>;
				phandle = <0x282>;

				iova-info {
					iova-reserve = <0x00 0x00 0x00 0xff000000>;
					limit-4g;
				};
			};
		};
	};

