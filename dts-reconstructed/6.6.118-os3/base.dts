/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#size-cells = <0x02>;
	#address-cells = <0x02>;
	model = "XiaoMi Xring_o1 Basic";
	compatible = "XiaoMi,Xring_o1-basic";

	vote_mng_lpctrl: vote_mng@e0106000 {
		compatible = "xring,vote_mng";
		reg = <0x00 0xe0106000 0x00 0x1000>;
		phandle = <0xdd>;

		m1_arbiter_lpctrl: m1_arbiter_lpctrl {
			compatible = "xring,vote_mng_m1_arbiter";
			regs = <0x00 0x04 0x18>;
			arb_num = <0x08>;
			ch_num = <0x08>;
			core = <0x03>;
			phandle = <0x26>;
		};

		m2_arbiter_lpctrl: m2_arbiter_lpctrl {
			compatible = "xring,vote_mng_m2_arbiter";
			regs = <0x124 0x128 0x12c>;
			arb_num = <0x04>;
			ch_num = <0x09>;
			core = <0x03>;
			phandle = <0x75>;
		};

		m3_arbiter_lpctrl: m3_arbiter_lpctrl {
			compatible = "xring,vote_mng_m3_arbiter";
			regs = <0x700 0x704 0x00>;
			arb_num = <0x06>;
			ch_num = <0x08>;
			core = <0x03>;
			phandle = <0xd3>;
		};
	};

	vote_mng_xctrlcpu: vote_mng@eb010000 {
		compatible = "xring,vote_mng";
		reg = <0x00 0xeb010000 0x00 0x1000>;
		phandle = <0xde>;

		m1_arbiter_xctrlcpu: m1_arbiter_xctrlcpu {
			compatible = "xring,vote_mng_m1_arbiter";
			regs = <0x00 0x04 0x18>;
			arb_num = <0x05>;
			ch_num = <0x05>;
			core = <0x01>;
			phandle = <0x25>;
		};

		m2_arbiter_xctrlcpu: m2_arbiter_xctrlcpu {
			compatible = "xring,vote_mng_m2_arbiter";
			regs = <0x124 0x128 0x12c>;
			arb_num = <0x09>;
			ch_num = <0x09>;
			core = <0x01>;
			phandle = <0x23>;
		};

		m3_arbiter_xctrlcpu: m3_arbiter_xctrlcpu {
			compatible = "xring,vote_mng_m3_arbiter";
			regs = <0x790 0x794 0x00>;
			arb_num = <0x07>;
			ch_num = <0x08>;
			core = <0x01>;
			phandle = <0x79>;
		};
	};

	vote_mng_xctrlddr: vote_mng@c0003000 {
		compatible = "xring,vote_mng";
		reg = <0x00 0xc0003000 0x00 0x1000>;
		phandle = <0xdf>;

		m1_arbiter_xctrlddr: m1_arbiter_xctrlddr {
			compatible = "xring,vote_mng_m1_arbiter";
			regs = <0x00 0x04 0x18>;
			arb_num = <0x05>;
			ch_num = <0x05>;
			core = <0x02>;
			phandle = <0x77>;
		};

		m2_arbiter0_xctrlddr: m2_arbiter0_xctrlddr {
			compatible = "xring,vote_mng_m2_arbiter";
			type = <0x01>;
			regs = <0x124 0x128 0x12c>;
			arb_num = <0x02>;
			ch_num = <0x09>;
			core = <0x02>;
			phandle = <0xe0>;
		};

		m2_arbiter1_xctrlddr: m2_arbiter1_xctrlddr {
			compatible = "xring,vote_mng_m2_arbiter";
			regs = <0x2a4 0x2a8 0x2ac>;
			arb_num = <0x01>;
			ch_num = <0x0c>;
			core = <0x02>;
			phandle = <0x02>;
		};

		m3_arbiter_xctrlddr: m3_arbiter_xctrlddr {
			compatible = "xring,vote_mng_m3_arbiter";
			regs = <0x700 0x704 0x00>;
			arb_num = <0x02>;
			ch_num = <0x08>;
			core = <0x02>;
			phandle = <0xe1>;
		};
	};

	vote_mng_test: vote_mng_test {
		compatible = "xring,vote_mng_test";
		vote-mngs = <0x02 0x00>;
		vote-mng-names = "vote_mng_test";
		phandle = <0xe2>;
	};

	cpus: cpus {
		#size-cells = <0x00>;
		#address-cells = <0x02>;
		phandle = <0xe3>;

		psci {
			compatible = "arm,psci-1.0";
			method = "smc";
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x03>;
				};

				core1 {
					cpu = <0x04>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x05>;
				};

				core1 {
					cpu = <0x06>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x07>;
				};

				core1 {
					cpu = <0x08>;
				};

				core2 {
					cpu = <0x09>;
				};

				core3 {
					cpu = <0x0a>;
				};
			};

			cluster3 {

				core0 {
					cpu = <0x0b>;
				};

				core1 {
					cpu = <0x0c>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			CPU_SLEEP_L: cpu-sleep-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0xd2>;
				exit-latency-us = <0x186>;
				min-residency-us = <0xf50>;
				phandle = <0x0d>;
			};

			CPU_SLEEP_ML: cpu-sleep-ml {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x8c>;
				exit-latency-us = <0x118>;
				min-residency-us = <0x370>;
				phandle = <0x12>;
			};

			CPU_SLEEP_M: cpu-sleep-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x5a>;
				exit-latency-us = <0x122>;
				min-residency-us = <0x24e>;
				phandle = <0x17>;
			};

			CPU_SLEEP_B: cpu-sleep-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x3c>;
				exit-latency-us = <0xb4>;
				min-residency-us = <0x168>;
				phandle = <0x1e>;
			};

			CLUSTER_SLEEP_L: cluster-sleep-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010000>;
				local-timer-stop;
				entry-latency-us = <0x19a>;
				exit-latency-us = <0x4e2>;
				min-residency-us = <0x259e>;
				phandle = <0x0e>;
			};

			CLUSTER_SLEEP_ML: cluster-sleep-ml {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010000>;
				local-timer-stop;
				entry-latency-us = <0x28a>;
				exit-latency-us = <0x2ee>;
				min-residency-us = <0x834>;
				phandle = <0x13>;
			};

			CLUSTER_SLEEP_M: cluster-sleep-M {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010000>;
				local-timer-stop;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x352>;
				min-residency-us = <0x672>;
				phandle = <0x18>;
			};

			CLUSTER_SLEEP_B: cluster-sleep-B {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010000>;
				local-timer-stop;
				entry-latency-us = <0x226>;
				exit-latency-us = <0x320>;
				min-residency-us = <0xece>;
				phandle = <0x1f>;
			};
		};

		CPU0: cpu@0 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			xring,amu = <0xeb290000>;
			enable-method = "psci";
			cpu-idle-states = <0x0d 0x0e>;
			capacity-dmips-mhz = <0x16a>;
			operating-points-v2 = <0x0f>;
			next-level-cache = <0x10>;
			#cooling-cells = <0x02>;
			phandle = <0x03>;

			L2_0: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x11>;
				phandle = <0x10>;

				L3_0: l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <0x03>;
					phandle = <0x11>;
				};
			};
		};

		CPU1: cpu@100 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x100>;
			xring,amu = <0xeb390000>;
			enable-method = "psci";
			cpu-idle-states = <0x0d 0x0e>;
			capacity-dmips-mhz = <0x16a>;
			operating-points-v2 = <0x0f>;
			next-level-cache = <0x10>;
