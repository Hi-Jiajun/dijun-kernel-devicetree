					interrupt-names = "vbat_drop", "over_temp", "ocp-ldo_adc", "ocp-ldo_coul", "ocp-ldo_pmu", "ocp-ulldo5", "ocp-lldo5", "ocp-mldo4", "ocp-mldo5", "ocp-mldo6", "ocp-mldo7", "ocp-mldo8", "ocp-hldo5", "ocp-hldo6", "ocp-hldo7", "ocp-hldo8", "ocp-hldo9", "ocp-hldo10", "ocp-ulldo1", "ocp-ulldo2", "ocp-lldo3", "ocp-lldo4", "ocp-mldo1", "ocp-mldo2", "ocp-hldo2", "ocp-hldo3";
					vote-mng-names = "CPUL", "CPUM_LP", "CPUM", "CPUB", "NPU", "GPU", "L3";
					vote-mngs = <0x23 0x00 0x23 0x01 0x23 0x02 0x23 0x03 0x23 0x05 0x23 0x06 0x23 0x04>;
