				cirrus,vpbr-atk-rate = <0x00>;
				cirrus,vpbr-atk-vol = <0x05>;
				cirrus,vpbr-max-att = <0x03>;
				cirrus,vpbr-thld = <0x08>;
				cirrus,gpio2-src-sel = <0x02>;
