			L2_4: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x11>;
				phandle = <0x1a>;
			};
		};

		CPU5: cpu@500 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x500>;
			xring,amu = <0xeb790000>;
			enable-method = "psci";
			cpu-idle-states = <0x17 0x18>;
			capacity-dmips-mhz = <0x214>;
			operating-points-v2 = <0x19>;
			next-level-cache = <0x1b>;
			#cooling-cells = <0x02>;
			phandle = <0x08>;

			L2_5: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x11>;
				phandle = <0x1b>;
			};
		};

		CPU6: cpu@600 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x600>;
			xring,amu = <0xeb890000>;
			enable-method = "psci";
