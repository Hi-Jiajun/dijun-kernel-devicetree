		xring_spmi: spmi@E0001000 {
			compatible = "xring,spmi-controller";
			reg = <0x00 0xe0001000 0x00 0x1000>;
			interrupts = <0x00 0x204 0x04>;
			spmi-channel = <0x01>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
