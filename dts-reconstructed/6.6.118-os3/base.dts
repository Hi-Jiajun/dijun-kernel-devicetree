		dw_i2c0: i2c@EC100000 {
			compatible = "snps,designware-i2c";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0xec100000 0x00 0x1000>;
			interrupts = <0x00 0x7f 0x04>;
			clock-frequency = <0x61a80>;
			clocks = <0x27 0xbf 0x27 0xcf>;
			clock-names = "pclk_i2c0", "clk_i2c0";
			resets = <0x28 0x0e 0x28 0x1f>;
			reset-names = "prst", "rst";
			i2c-scl-falling-time-ns = <0x12c 0x118 0x64 0x0a>;
			i2c-sda-falling-time-ns = <0x12c 0x118 0x64 0x32>;
			tHD,DAT = <0x190 0x190 0xa0 0x00>;
			status = "disabled";
			scl-gpios = <0x42 0x03 0x00>;
			sda-gpios = <0x42 0x04 0x00>;
