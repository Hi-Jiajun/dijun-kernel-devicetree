			capacity-dmips-mhz = <0x214>;
			operating-points-v2 = <0x14>;
			next-level-cache = <0x15>;
			#cooling-cells = <0x02>;
			phandle = <0x05>;

			L2_2: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x11>;
				phandle = <0x15>;
			};
		};

		CPU3: cpu@300 {
			status = "okay";
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x300>;
			xring,amu = <0xeb590000>;
