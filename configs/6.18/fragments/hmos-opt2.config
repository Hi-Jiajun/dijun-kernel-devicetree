# 启用 HarmonyOS IPC 只读类型化导出表与 6.18.32-hmos-opt2 KMI 安全特性集
# 必须配合 patches/6.18/hmos/0001-dijun-hmos-ipc-readonly-typed-api-v2.patch 与 ksym-whitelist-hmos-opt2.txt
# 实测全部 3,948 基线符号 0 CRC 漂移（module_layout=0x60801db3, dijun_hmos_ipc_api_v2=0xcf4c0200）
CONFIG_DIJUN_HMOS_IPC_API=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_BBR=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
