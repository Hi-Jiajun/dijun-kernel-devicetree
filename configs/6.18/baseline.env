# 当前设备默认内核基线（2026-11-17 同步至 OS4.0.4.0 / 6.18.32-4k）
# 按场景区分的完整基线见 configs/6.18/baselines/{os4.0.0.19,os4.0.4.0-pure,os4.0.4.0-hmos}.env
BASELINE_ID=os4.0.4.0-pure
KERNEL_BRANCH=android17-6.18-2026-09
KERNEL_VERSION=6.18.32
SOURCE_COMMIT=ecdaacc9a0ee87eaf9544e1836d86bd9d590312e
CLANG_VERSION=r584948c
CLANG_FULL="Android (15323222) clang 22.0.1"
RUST_VERSION=1.91.1.p3
RUST_BUILD=15551131
BINDGEN_VERSION=0.73.2
CONFIG=configs/6.18/dijun-os4.0.4.0.config
WHITELIST=configs/6.18/ksym-whitelist-os4.0.4.0.txt
IMAGE_SHA256=f90b59d0ce7149e8049ff041f18c428370c4bcd7af8e0e1d6968e4f9bdacfed4
VMLINUX_SYMVERS=symvers/6.18.32-os4.0.4.0/vmlinux-pure.symvers
VENDOR_SYMVERS=symvers/6.18.32-os4.0.4.0/vendor-modules.symvers
MODULE_LAYOUT_CRC=0x60801db3
DEVICE_VERIFIED="2026-11-14..17 / OS4.0.4.0 / slot b (6.18.32-4k)"

# ---- vermagic 契约（因 ENOEXEC 事故固化）----
# 任何外部模块必须与本段逐字一致，否则 insmod 报 "Exec format error"。
# 实测来源：设备 /proc/version = "Linux version 6.18.32-4k (<user>@<host>) ..."
UTS_RELEASE=6.18.32-4k
CONFIG_LOCALVERSION="-4k"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_MODVERSIONS=y
VERMAGIC="6.18.32-4k SMP preempt mod_unload modversions aarch64"
# 验收：
#   1. strings <module>.ko | grep vermagic 必须等于上面 VERMAGIC，不得带 + 或 -<git>-dirty 后缀；
#      （注意：LOCALVERSION_AUTO=n 时若不在 make 命令行显式传 LOCALVERSION=""，setlocalversion 仍可能追加 "+"）
#   2. 模块期望的 module_layout CRC 必须等于 MODULE_LAYOUT_CRC (0x60801db3)。
#
# ---- 命名策略 ----
# 当前 UTS_RELEASE 由已烧入设备的成品内核决定，不可单独改名。
# 若将来要换成更描述性的 LOCALVERSION（如 -4k-dijun），必须一次性执行：
#   改内核 LOCALVERSION -> 重刷内核 -> 同一批所有模块全部重编。
# 严禁新旧 vermagic 混用；统一调整留待成品收尾阶段执行。
